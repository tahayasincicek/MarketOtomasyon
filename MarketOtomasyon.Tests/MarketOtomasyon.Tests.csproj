<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarketOtomasyon\MarketOtomasyon.csproj" />
  </ItemGroup>

  <!-- Ayar dosyalari test ciktisina kopyalanir; AyarDosyalariTests onlari
       okuyup gecerli JSON olduklarini ve uretim dosyasina baglanti dizesi
       sizmadigini dogrular. Klasorden yukari tirmanip proje kokunu aramak
       kirilgan: cikti yolu degistiginde test yanlis yerde arar. -->
  <ItemGroup>
    <None Include="..\MarketOtomasyon\appsettings*.json;..\MarketOtomasyon\appsettings*.ornek"
          Link="ayarlar\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Dockerfile;..\.dockerignore"
          Link="docker\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
