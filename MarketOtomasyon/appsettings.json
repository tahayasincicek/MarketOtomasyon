{
  "Satis": {
    "DepoKodu": "MRK",
    "NegatifStogaIzinVer": false
  },
  "Iade": {
    "SureGun": 30
  },
  "UrunResim": {
    "ApiTabani": "https://world.openfoodfacts.org/api/v2/product/",
    "KullaniciAjani": "MarketOtomasyon/1.0 (staj-projesi)",
    "KlasorAdi": "urun-resim",
    "IstekAraligiMs": 4500,
    "ZamanAsimiSaniye": 15
  },
  "TersProxy": {
    "Etkin": false,
    "TumProxylereGuven": false,
    "GuvenilenProxyler": [],
    "GuvenilenAglar": []
  },
  "VeriKoruma": {
    "UygulamaAdi": "MarketOtomasyon",
    "AnahtarKlasoru": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Loglar/market-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
