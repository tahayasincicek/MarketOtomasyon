{
  // Baglanti dizesi BILEREK burada yok.
  //
  // Uretim sunucusunun kullanici adi ve sifresi kaynak koda girmemeli:
  // bir kez commit'lendiginde gecmisten silinmesi zordur ve repoyu
  // goren herkes veritabanina erisebilir hale gelir.
  //
  // Bunun yerine ortam degiskeninden okunur. Ad'daki cift alt cizgi,
  // ASP.NET Core'un ic ice ayar karsiligidir (ConnectionStrings:MarketDb):
  //
  //   Windows (kalici):
  //     setx ConnectionStrings__MarketDb "Server=...;Database=...;User Id=...;Password=..."
  //
  //   Docker:
  //     docker run -e "ConnectionStrings__MarketDb=Server=...;..." marketotomasyon
  //
  // Deger tanimli degilse uygulama acilista anlamli bir hatayla durur;
  // ilk istegi bekleyip orada patlamaz.

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },

  // Uretimde uygulamanin hangi alan adlarindan istek kabul edecegi
  // daraltilmali. Yildiz birakmak Host basligi sahteciligine acik
  // birakir; kendi alan adinla degistir.
  "AllowedHosts": "*"
}
