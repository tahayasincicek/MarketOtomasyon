@{
    // Aktif menu ogesini isaretlemek icin: hangi controller'dayiz?
    var aktifKontrolcu = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Aktif(string kontrolcu) => aktifKontrolcu == kontrolcu ? "aktif" : "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MarketOtomasyon</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MarketOtomasyon.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="yerlesim">
        <aside class="yan-menu" id="yan-menu">
            <a class="marka" asp-controller="Kasa" asp-action="Index">
                <span class="marka-kisa">MO</span>
                <span class="marka-ad">Market Otomasyonu</span>
            </a>

            <nav class="menu">
                <div class="menu-baslik">Satış</div>
                <a class="menu-oge @Aktif("Kasa")" asp-controller="Kasa" asp-action="Index">
                    <span class="menu-ikon">🧾</span> Kasa
                </a>

                <div class="menu-baslik">Yönetim</div>
                <a class="menu-oge @Aktif("Urun")" asp-controller="Urun" asp-action="Index">
                    <span class="menu-ikon">📦</span> Ürünler
                </a>
                <a class="menu-oge @Aktif("Stok")" asp-controller="Stok" asp-action="Index">
                    <span class="menu-ikon">🏷️</span> Stok
                </a>
            </nav>

            <div class="menu-alt">
                <div class="menu-kullanici">
                    <div class="menu-kullanici-ad">Test Kasiyer</div>
                    <div class="menu-kullanici-rol">kasiyer1</div>
                </div>
            </div>
        </aside>

        <div class="icerik">
            <header class="ust-serit">
                <button type="button" class="menu-dugmesi" id="menu-dugmesi" aria-label="Menüyü aç/kapat">☰</button>
                <span class="sayfa-basligi">@ViewData["Title"]</span>
            </header>

            <main role="main" class="sayfa">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
