@{
    // Aktif menu ogesini isaretlemek icin: hangi controller'dayiz?
    var aktifKontrolcu = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Aktif(string kontrolcu) => aktifKontrolcu == kontrolcu ? "aktif" : "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MarketOtomasyon</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* Phosphor Icons: yazarkasa, kasa kasasi, depo, barkod gibi market
       otomasyonuna ozgu ikonlari tek sette bulunduran nadir setlerden.
       Yazi tipiyle ayni gerekce: CDN degil, projeye gomulu. *@
    <link rel="stylesheet" href="~/lib/phosphor-icons/phosphor.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MarketOtomasyon.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="yerlesim">
        <aside class="yan-menu" id="yan-menu">
            <nav class="menu">
                <div class="menu-baslik">Satış</div>
                <a class="menu-oge @Aktif("Kasa")" asp-controller="Kasa" asp-action="Index">
                    <i class="menu-ikon ph ph-cash-register"></i> Kasa
                </a>
                <a class="menu-oge @Aktif("Iade")" asp-controller="Iade" asp-action="Index">
                    <i class="menu-ikon ph ph-arrow-counter-clockwise"></i> İade
                </a>
                <a class="menu-oge @Aktif("Vardiya")" asp-controller="Vardiya" asp-action="Index">
                    <i class="menu-ikon ph ph-vault"></i> Vardiya
                </a>

                <div class="menu-baslik">Yönetim</div>
                <a class="menu-oge @Aktif("Urun")" asp-controller="Urun" asp-action="Index">
                    <i class="menu-ikon ph ph-package"></i> Ürünler
                </a>
                <a class="menu-oge @Aktif("Stok")" asp-controller="Stok" asp-action="Index">
                    <i class="menu-ikon ph ph-warehouse"></i> Stok
                </a>
                <a class="menu-oge @Aktif("Sayim")" asp-controller="Sayim" asp-action="Index">
                    <i class="menu-ikon ph ph-list-checks"></i> Sayım ve Zayi
                </a>
                <a class="menu-oge @Aktif("Kampanya")" asp-controller="Kampanya" asp-action="Index">
                    <i class="menu-ikon ph ph-tag"></i> Kampanyalar
                </a>
            </nav>

           
        </aside>

        <div class="icerik">
            @* Ust serit her ekranda ayni: nerede oldugun (sol), kim oldugun ve
               vardiyanin acik olup olmadigi (sag). Kasiyer bunlari sormak icin
               ekran degistirmez. *@
            <header class="ust-serit">
                <button type="button" class="menu-dugmesi" id="menu-dugmesi" aria-label="Menüyü aç/kapat"><i class="ph ph-list"></i></button>
                <span class="sayfa-basligi">@ViewData["Title"]</span>

                <div class="arac-sag serit-grup">
                    @await Component.InvokeAsync("VardiyaDurumu")
                    <span class="serit-grup serit-saat-grup">
                        <span class="arac-ayrac"></span>
                        <span class="serit-vardiya" id="serit-saat">—</span>
                    </span>
                </div>
            </header>

            <main role="main" class="sayfa">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
