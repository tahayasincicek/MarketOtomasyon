@{
    // Aktif menu ogesini isaretlemek icin: hangi controller'dayiz?
    var aktifKontrolcu = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Aktif(string kontrolcu) => aktifKontrolcu == kontrolcu ? "aktif" : "";

    // Menu gruplari acilir-kapanir. Icinde bulundugun grup acik gelir;
    // digerleri kapali durur ki sol serit kalabaliklasmasin.
    var satisGrubu   = new[] { "Kasa", "Iade", "Vardiya" };
    var bilgiGrubu   = new[] { "Urun", "Stok" };
    var yonetimGrubu = new[] { "Sayim", "Kampanya", "Maliyet", "Rapor", "Personel", "IslemLog", "Transfer", "Tedarikci", "AlisFaturasi", "SonKullanma" };
    bool GrupAcik(string[] grup) => grup.Contains(aktifKontrolcu);
}
<!DOCTYPE html>
<html lang="tr" class="uygulama-html">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MarketOtomasyon</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* Phosphor Icons: yazarkasa, kasa kasasi, depo, barkod gibi market
       otomasyonuna ozgu ikonlari tek sette bulunduran nadir setlerden.
       Yazi tipiyle ayni gerekce: CDN degil, projeye gomulu. *@
    <link rel="stylesheet" href="~/lib/phosphor-icons/phosphor.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/buton-temasi.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MarketOtomasyon.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="yerlesim">
        <aside class="yan-menu" id="yan-menu">
            <nav class="menu">
                @* Ana ekran her role acik ve grup disinda: her yerden tek
                   tikla donulebilmeli. *@
                <a class="menu-oge @Aktif("Home")" asp-controller="Home" asp-action="Index">
                    <i class="menu-ikon ph ph-house"></i> Ana Sayfa
                </a>

                @* Gruplar <details> ile aciliyor: JavaScript gerekmez,
                   klavyeyle gezilebilir ve tarayici durumu kendisi tutar.
                   "open" yalnizca icinde bulunulan grupta acik gelir. *@
                <details class="menu-grup" data-menu-grup="satis" open="@GrupAcik(satisGrubu)">
                    <summary class="menu-baslik">
                        <i class="menu-grup-ok ph ph-caret-right"></i> Satış
                    </summary>
                    <a class="menu-oge @Aktif("Kasa")" asp-controller="Kasa" asp-action="Index">
                        <i class="menu-ikon ph ph-cash-register"></i> Kasa
                    </a>
                    <a class="menu-oge @Aktif("Iade")" asp-controller="Iade" asp-action="Index">
                        <i class="menu-ikon ph ph-arrow-counter-clockwise"></i> İade
                    </a>
                    <a class="menu-oge @Aktif("Vardiya")" asp-controller="Vardiya" asp-action="Index">
                        <i class="menu-ikon ph ph-vault"></i> Vardiya
                    </a>
                </details>

                <details class="menu-grup" data-menu-grup="bilgi" open="@GrupAcik(bilgiGrubu)">
                    <summary class="menu-baslik">
                        <i class="menu-grup-ok ph ph-caret-right"></i> Bilgi
                    </summary>
                    <a class="menu-oge @Aktif("Urun")" asp-controller="Urun" asp-action="Index">
                        <i class="menu-ikon ph ph-package"></i> Ürünler
                    </a>
                    <a class="menu-oge @Aktif("Stok")" asp-controller="Stok" asp-action="Index">
                        <i class="menu-ikon ph ph-warehouse"></i> Stok
                    </a>
                </details>

                @if (User.IsInRole("Mudur"))
                {
                    <details class="menu-grup" data-menu-grup="yonetim" open="@GrupAcik(yonetimGrubu)">
                        <summary class="menu-baslik">
                            <i class="menu-grup-ok ph ph-caret-right"></i> Yönetim
                        </summary>
                        <a class="menu-oge @Aktif("Sayim")" asp-controller="Sayim" asp-action="Index">
                            <i class="menu-ikon ph ph-list-checks"></i> Sayım ve Zayi
                        </a>
                        <a class="menu-oge @Aktif("Kampanya")" asp-controller="Kampanya" asp-action="Index">
                            <i class="menu-ikon ph ph-tag"></i> Kampanyalar
                        </a>
                        <a class="menu-oge @Aktif("Maliyet")" asp-controller="Maliyet" asp-action="Index">
                            <i class="menu-ikon ph ph-chart-line-up"></i> Kâr Marjı
                        </a>
                        <a class="menu-oge @Aktif("Rapor")" asp-controller="Rapor" asp-action="Index">
                            <i class="menu-ikon ph ph-chart-bar"></i> Raporlar
                        </a>
                        <a class="menu-oge @Aktif("SonKullanma")" asp-controller="SonKullanma" asp-action="Index">
                            <i class="menu-ikon ph ph-clock-countdown"></i> Son Kullanma
                        </a>
                        <a class="menu-oge @Aktif("Transfer")" asp-controller="Transfer" asp-action="Index">
                            <i class="menu-ikon ph ph-arrows-left-right"></i> Depo Transferi
                        </a>
                        <a class="menu-oge @Aktif("Tedarikci")" asp-controller="Tedarikci" asp-action="Index">
                            <i class="menu-ikon ph ph-truck"></i> Tedarikçiler
                        </a>
                        <a class="menu-oge @Aktif("AlisFaturasi")" asp-controller="AlisFaturasi" asp-action="Index">
                            <i class="menu-ikon ph ph-receipt"></i> Alış Faturaları
                        </a>
                        <a class="menu-oge @Aktif("Personel")" asp-controller="Personel" asp-action="Index">
                            <i class="menu-ikon ph ph-users-three"></i> Personel
                        </a>
                        <a class="menu-oge @Aktif("IslemLog")" asp-controller="IslemLog" asp-action="Index">
                            <i class="menu-ikon ph ph-list-magnifying-glass"></i> İşlem Logları
                        </a>
                    </details>
                }
            </nav>

           
        </aside>

        <div class="icerik">
            @* Ust serit her ekranda ayni: nerede oldugun (sol), kim oldugun ve
               vardiyanin acik olup olmadigi (sag). Kasiyer bunlari sormak icin
               ekran degistirmez. *@
            <header class="ust-serit">
                <button type="button" class="menu-dugmesi" id="menu-dugmesi" aria-label="Menüyü aç/kapat"><i class="ph ph-list"></i></button>
                <span class="sayfa-basligi">@ViewData["Title"]</span>

                <div class="ms-auto">
                    @* Rol rozeti kaldirildi: rol zaten menudeki ekranlarla
                       belli oluyor ve her ekranda tekrar etmesi gereksizdi. *@
                    <div class="dropdown">
                        <button class="hesap-dugmesi" type="button" data-bs-toggle="dropdown"
                                aria-expanded="false" aria-label="Hesap menüsü">
                            <span class="hesap-avatar"><i class="ph ph-user"></i></span>
                            <span class="hesap-ad">@User.Identity?.Name</span>
                            <i class="ph ph-caret-down hesap-ok"></i>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end hesap-menu">
                            <li>
                                <a class="dropdown-item" asp-controller="Profil" asp-action="Index">
                                    <i class="ph ph-user"></i> Hesabım
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Profil" asp-action="Index"
                                   asp-fragment="sifre">
                                    <i class="ph ph-key"></i> Şifre değiştir
                                </a>
                            </li>

                            @if (User.IsInRole("Mudur"))
                            {
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Personel" asp-action="Index">
                                        <i class="ph ph-users-three"></i> Personel yönetimi
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="IslemLog" asp-action="Index">
                                        <i class="ph ph-list-checks"></i> İşlem logları
                                    </a>
                                </li>
                            }

                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                @* Cikis POST olmali: GET ile yapilsaydi baska bir
                                   sitedeki bir resim etiketi kullaniciyi oturumdan
                                   dusurebilirdi. *@
                                <form asp-controller="Hesap" asp-action="Cikis" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item hesap-cikis">
                                        <i class="ph ph-sign-out"></i> Çıkış
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>

            </header>

            <main role="main" class="sayfa">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
