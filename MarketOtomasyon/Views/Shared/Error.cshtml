@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="ekran">
    <div class="bildirim bildirim-olumsuz">
        <i class="ph ph-warning-octagon"></i>
        <span>İsteğiniz işlenirken bir hata oluştu.</span>
    </div>

    <div class="bolum form-ekran">
        <div class="bolum-baslik">Ne yapabilirsiniz?</div>

        <div class="alan">
            <label>Öneri</label>
            <div class="deger">
                Sayfayı yenilemeyi deneyin. Sorun sürerse, aşağıdaki numarayla birlikte
                sistem sorumlunuza bildirin.
            </div>
        </div>

        @if (Model.ShowRequestId)
        {
            <div class="alan">
                <label>Hata numarası</label>
                <div class="deger">
                    <span class="kod">@Model.RequestId</span>
                </div>
            </div>
        }

        <div class="alan">
            <label></label>
            <div class="deger">
                <a class="btn btn-primary btn-sm" asp-controller="Home" asp-action="Index">
                    <i class="ph ph-house"></i> Ana Ekran
                </a>
                <a class="btn btn-secondary btn-sm" asp-controller="Kasa" asp-action="Index">
                    <i class="ph ph-cash-register"></i> Kasa
                </a>
            </div>
        </div>
    </div>

    <div class="durum-cubugu">
        <span class="ipucu">
            Ayrıntılı hata dökümü yalnızca geliştirme ortamında gösterilir; kasa terminalinde
            müşteriye teknik ayrıntı yansımaz.
        </span>
    </div>
</div>
