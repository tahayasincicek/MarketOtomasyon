@model MarketOtomasyon.Models.ViewModels.TedarikciListeVm
@{
    ViewData["Title"] = "Tedarikçiler";
}

<div class="ekran">
    @if (TempData["Mesaj"] is string mesaj)
    {
        <div class="bildirim bildirim-olumlu"><i class="ph ph-check-circle"></i> @mesaj</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Hata))
    {
        <div class="bildirim bildirim-olumsuz"><i class="ph ph-warning"></i> @Model.Hata</div>
    }

    <div class="arac-cubugu">
        <a class="btn btn-primary" asp-action="Ekle">
            <i class="ph ph-plus"></i> Yeni Tedarikçi
        </a>

        <span class="arac-ayrac"></span>

        <form method="get" asp-action="Index" class="form-seffaf">
            <div class="arac-alan">
                <i class="ph ph-magnifying-glass text-muted"></i>
                <input name="arama" value="@Model.Arama" class="form-control" style="width:16rem"
                       placeholder="Kod veya unvan ara" aria-label="Kod veya unvan ara" autofocus />
            </div>

            <div class="form-check ms-1">
                <input type="checkbox" name="sadeceAktif" value="true" class="form-check-input"
                       id="sadeceAktif" checked="@Model.SadeceAktif" />
                <label class="form-check-label small" for="sadeceAktif">Sadece aktif</label>
            </div>

            <button type="submit" class="btn btn-primary">Uygula</button>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.Arama))
        {
            <a class="btn btn-link btn-sm" asp-action="Index">Temizle</a>
        }
    </div>

    <div class="izgara-sarmal">
        <table class="izgara">
            <thead>
                <tr>
                    <th style="width:8rem">Kod</th>
                    <th>Unvan</th>
                    <th style="width:10rem">Vergi No</th>
                    <th style="width:10rem">Telefon</th>
                    <th style="width:6rem">Durum</th>
                    <th class="islem" style="width:5rem"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Satirlar)
                {
                    <tr class="@(t.Aktif ? "" : "pasif")">
                        <td class="kod">@t.Kod</td>
                        <td>@t.Unvan</td>
                        <td>@(t.VergiNo ?? "—")</td>
                        <td>@(t.Telefon ?? "—")</td>
                        <td>
                            @if (t.Aktif)
                            {
                                <span class="rozet rozet-olumlu">aktif</span>
                            }
                            else
                            {
                                <span class="rozet rozet-notr">pasif</span>
                            }
                        </td>
                        <td class="islem">
                            <a class="btn btn-outline-primary" asp-action="Duzenle" asp-route-id="@t.Id"
                               title="Düzenle"><i class="ph ph-pencil-simple"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.Satirlar.Count == 0)
        {
            <p class="veri-yok">Kayıtlı tedarikçi yok.</p>
        }
    </div>

    <div class="durum-cubugu">
        <span><strong>@Model.Satirlar.Count</strong> tedarikçi</span>
    </div>
</div>
