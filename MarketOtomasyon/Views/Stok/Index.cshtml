@model MarketOtomasyon.Models.ViewModels.StokListeVm
@using MarketOtomasyon.Models.ViewModels
@{
    ViewData["Title"] = "Stok Durumu";
    var kritikSayisi = Model.Satirlar.Count(s => s.Kritik);
}

<div class="ekran">
    <form method="get" class="arac-cubugu">
        <a class="btn btn-primary" asp-action="Giris">
            <i class="bi bi-box-arrow-in-down"></i> Mal Kabul
        </a>

        <span class="arac-ayrac"></span>

        <div class="arac-alan">
            <i class="bi bi-search text-muted"></i>
            <input name="arama" value="@Model.Arama" class="form-control" style="width:18rem"
                   placeholder="Kod veya ürün adı ara" aria-label="Kod veya ürün adı ara" autofocus />
        </div>

        <div class="form-check ms-1">
            <input type="checkbox" name="sadeceKritik" value="true" class="form-check-input"
                   id="sadeceKritik" checked="@Model.SadeceKritik" />
            <label class="form-check-label small" for="sadeceKritik">Sadece kritik seviye</label>
        </div>

        <button type="submit" class="btn btn-outline-secondary">Uygula</button>

        @if (!string.IsNullOrWhiteSpace(Model.Arama) || Model.SadeceKritik)
        {
            <a class="btn btn-link btn-sm" asp-action="Index">Temizle</a>
        }
    </form>

    <div class="izgara-sarmal">
        <table class="izgara">
            <thead>
                <tr>
                    <th style="width:8rem">Kod</th>
                    <th>Ürün</th>
                    <th style="width:5rem">Birim</th>
                    <th class="sayi" style="width:8rem">Min. Stok</th>
                    <th class="sayi" style="width:8rem">Bakiye</th>
                    <th style="width:6rem">Durum</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var satir in Model.Satirlar)
                {
                    @* Kritik satir hem zeminden hem rozetten okunur: renge
                       bagimli kalinmasin. *@
                    <tr class="@(satir.Kritik ? "kritik" : "")">
                        <td class="kod">@satir.Kod</td>
                        <td>
                            <span class="urun-hucre">
                                <partial name="_UrunResmi"
                                         model="@UrunResmiVm.Olustur(satir.ResimYolu, satir.Ad)" />
                                <span class="urun-hucre-metin">@satir.Ad</span>
                            </span>
                        </td>
                        <td>@satir.Birim</td>
                        <td class="sayi text-muted">@satir.MinStokSeviyesi.ToString("0.###")</td>
                        <td class="sayi fw-semibold">@satir.ToplamBakiye.ToString("0.###")</td>
                        <td>
                            @if (satir.Kritik)
                            {
                                <span class="rozet rozet-uyari">kritik</span>
                            }
                            else
                            {
                                <span class="rozet rozet-olumlu">yeterli</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.Satirlar.Count == 0)
        {
            <p class="veri-yok">Aramanıza uyan stok kaydı bulunamadı.</p>
        }
    </div>

    <div class="durum-cubugu">
        <span><strong>@Model.ToplamKayit</strong> kayıt</span>
        <span>Sayfa @Model.Sayfa / @Model.ToplamSayfa</span>
        @if (kritikSayisi > 0)
        {
            <span class="rozet rozet-uyari">bu sayfada @kritikSayisi kritik ürün</span>
        }

        <div class="arac-sag">
            <ul class="pagination pagination-sm">
                <li class="page-item @(Model.OncekiVar ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-arama="@Model.Arama"
                       asp-route-sadeceKritik="@Model.SadeceKritik"
                       asp-route-sayfa="@(Model.Sayfa - 1)">‹ Önceki</a>
                </li>
                <li class="page-item @(Model.SonrakiVar ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-arama="@Model.Arama"
                       asp-route-sadeceKritik="@Model.SadeceKritik"
                       asp-route-sayfa="@(Model.Sayfa + 1)">Sonraki ›</a>
                </li>
            </ul>
        </div>
    </div>
</div>
