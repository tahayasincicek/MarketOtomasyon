@model MarketOtomasyon.Models.ViewModels.MalKabulVm
@{
    ViewData["Title"] = "Mal Kabul";
}

<div class="ekran">
    <div class="arac-cubugu">
        <a class="btn btn-outline-secondary" asp-action="Index">
            <i class="ph ph-arrow-left"></i> Stok Durumu
        </a>
        <span class="arac-ayrac"></span>
        <span class="ipucu">
            Her giriş bir stok hareketi olarak yazılır; bakiye hareketlerin toplamından okunur.
        </span>
    </div>

    @if (TempData["Mesaj"] is string mesaj)
    {
        <div class="bildirim bildirim-olumlu"><i class="ph ph-check-circle"></i> @mesaj</div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="bildirim bildirim-olumsuz">
            <i class="ph ph-warning"></i>
            <div asp-validation-summary="All" class="mb-0"></div>
        </div>
    }

    <div class="panel-serit" style="flex:1; min-height:0; align-items:stretch">

        <!-- Giris formu -->
        <div class="panel" style="flex:1 1 24rem">
            <div class="panel-baslik"><span><i class="ph ph-tray-arrow-down"></i> Giriş</span></div>
            <div class="panel-govde">
                <form id="mal-kabul-form"
                      method="post"
                      asp-action="Giris"
                      data-barkod-coz-url="@Url.Action("Coz", "Barkod")">
                    <div class="alan">
                        <label asp-for="Barkod">Barkod</label>
                        <div class="deger">
                            <div class="input-group">
                                <input id="barkod"
                                       class="form-control font-monospace"
                                       asp-for="Barkod"
                                       autocomplete="off"
                                       autofocus
                                       placeholder="Okutun, yazın veya kamerayı kullanın" />

                                <button type="button"
                                        id="btn-kamera"
                                        class="btn btn-outline-secondary">
                                    <i class="ph ph-video-camera"></i> Kamera
                                </button>
                            </div>

                            <span class="hata" asp-validation-for="Barkod"></span>

                            <input asp-for="UrunId" type="hidden" />

                            <div id="mal-kabul-urun-bilgi"
                                 class="bildirim bildirim-bilgi d-none mt-2"
                                 role="status"
                                 aria-live="polite"></div>
                        </div>
                    </div>

                    <div id="kamera-paneli"
                         class="arac-cubugu d-none mb-3"
                         style="background:#f8fafc">

                        <video id="kamera-video"
                               playsinline
                               muted
                               style="width:22rem;max-width:100%;height:12rem;object-fit:cover;background:#111827;border-radius:.25rem">
                        </video>

                        <div class="d-flex flex-column gap-1" style="min-width:0">
                            <span class="arac-etiket">Kamera</span>

                            <select id="kamera-secim"
                                    class="form-select"
                                    style="width:15rem"
                                    aria-label="Kamera seç">
                            </select>

                            <div id="kamera-durum" class="ipucu">Kamera kapalı.</div>
                            <div id="kamera-son" class="ipucu"></div>
                        </div>

                        <span class="ipucu arac-sag" style="max-width:18rem">
                            Barkodu kameranın ortasına ve ekrana paralel tutun.
                            Ürün bulunduğunda kamera kapanır ve miktar alanına geçilir.
                        </span>
                    </div>

                    <div class="alan">
                        <label asp-for="DepoId">Depo</label>
                        <div class="deger">
                            <select class="form-select orta-genislik" asp-for="DepoId">
                                <option value="0">(seçiniz)</option>
                                @foreach (var depo in Model.Depolar)
                                {
                                    <option value="@depo.Id" selected="@(Model.DepoId == depo.Id)">@depo.Ad</option>
                                }
                            </select>
                            <span class="hata" asp-validation-for="DepoId"></span>
                        </div>
                    </div>

                    <div class="alan">
                        <label asp-for="Miktar">Miktar</label>
                        <div class="deger">
                            <input class="form-control dar text-end" asp-for="Miktar"
                                   type="number" step="0.001" min="0" />
                            <span class="hata" asp-validation-for="Miktar"></span>
                        </div>
                    </div>

                    <div class="alan">
                        <label></label>
                        <div class="deger ipucu">Koli barkodu okutulsa da miktar buradan girilir.</div>
                    </div>

                    <div class="alan">
                        <label asp-for="BirimMaliyet">Birim maliyet</label>
                        <div class="deger">
                            <div class="input-group dar">
                                <input class="form-control text-end" asp-for="BirimMaliyet"
                                       type="number" step="0.01" min="0.01" />
                                <span class="input-group-text">₺</span>
                            </div>
                            <span class="hata" asp-validation-for="BirimMaliyet"></span>
                            <div class="ipucu mt-1">KDV hariç alış birim maliyetini girin.</div>
                        </div>
                    </div>

                    <div class="alan">
                        <label asp-for="Aciklama">Açıklama</label>
                        <div class="deger">
                            <input class="form-control" asp-for="Aciklama"
                                   placeholder="İrsaliye no, tedarikçi vb." />
                        </div>
                    </div>

                    <div class="alan">
                        <label></label>
                        <div class="deger">
                            <button type="submit" class="btn btn-primary">
                                <i class="ph ph-check"></i> Girişi Kaydet
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Son hareketler -->
        <div class="panel" style="flex:2 1 32rem">
            <div class="panel-baslik"><span><i class="ph ph-list-bullets"></i> Son hareketler</span></div>

            <div class="izgara-sarmal">
                <table class="izgara">
                    <thead>
                        <tr>
                            <th style="width:8rem">Tarih</th>
                            <th>Ürün</th>
                            <th style="width:9rem">Depo</th>
                            <th style="width:8rem">Kaynak</th>
                            <th class="sayi" style="width:9rem">Miktar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var hareket in Model.SonHareketler)
                        {
                            <tr>
                                <td class="text-muted">@hareket.Tarih.ToLocalTime().ToString("dd.MM HH:mm")</td>
                                <td style="white-space:normal">
                                    <span class="kod">@hareket.UrunKod</span> @hareket.UrunAd
                                    @if (!string.IsNullOrWhiteSpace(hareket.Aciklama))
                                    {
                                        <span class="ipucu">· @hareket.Aciklama</span>
                                    }
                                </td>
                                <td>@hareket.DepoAd</td>
                                <td><span class="rozet rozet-notr">@hareket.KaynakAdi</span></td>
                                @* Giris/cikis yonu isaretle de belirtilir: renge bagimli kalinmasin. *@
                                <td class="sayi @(hareket.Yon == 1 ? "text-success" : "text-danger")">
                                    @(hareket.Yon == 1 ? "+" : "−")@hareket.Miktar.ToString("0.###") @hareket.Birim
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (Model.SonHareketler.Count == 0)
                {
                    <p class="veri-yok">Henüz stok hareketi yok.</p>
                }
            </div>
        </div>
    </div>

    <div class="durum-cubugu">
        <span>Son <strong>@Model.SonHareketler.Count</strong> hareket listeleniyor</span>
        <span class="arac-sag">Satış ve iade hareketleri de burada görünür.</span>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="~/lib/zxing/index.min.js" asp-append-version="true"></script>
    <script src="~/js/mal-kabul.js" asp-append-version="true"></script>
    <script src="~/js/kamera.js" asp-append-version="true"></script>
}
