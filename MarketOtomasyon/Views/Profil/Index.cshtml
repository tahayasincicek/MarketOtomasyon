@model MarketOtomasyon.Models.ViewModels.ProfilVm
@{
    ViewData["Title"] = "Hesabım";

    var yerelVardiya = Model.AcikVardiyaAcilisUtc is DateTime acilisUtc
        ? TimeZoneInfo.ConvertTimeFromUtc(
            acilisUtc, TimeZoneInfo.FindSystemTimeZoneById("Turkey Standard Time"))
        : (DateTime?)null;
}

<div class="ekran">
    @if (TempData["Mesaj"] is string mesaj)
    {
        <div class="bildirim bildirim-olumlu"><i class="ph ph-check-circle"></i> @mesaj</div>
    }

    @* ---------- Hesap bilgileri ---------- *@
    <div class="panel">
        <div class="panel-baslik">
            <span><i class="ph ph-identification-card"></i> Hesap bilgileri</span>
        </div>

        <div style="padding:.5rem .7rem">
            <div class="kunye">
                <div class="kunye-oge">
                    <div class="kunye-etiket">Kullanıcı adı</div>
                    <div class="kunye-deger font-monospace">@Model.KullaniciAdi</div>
                </div>
                <div class="kunye-oge">
                    <div class="kunye-etiket">Ad soyad</div>
                    <div class="kunye-deger">@Model.AdSoyad</div>
                </div>
                <div class="kunye-oge">
                    <div class="kunye-etiket">Rol</div>
                    <div class="kunye-deger">@Model.RolAdi</div>
                </div>
                <div class="kunye-oge">
                    <div class="kunye-etiket">Açık vardiya</div>
                    <div class="kunye-deger">
                        @if (yerelVardiya is DateTime acilis)
                        {
                            @* Tarihler UTC saklanir; ekranda yerel saate cevrilir. *@
                            <span class="rozet rozet-olumlu">
                                @acilis.ToString("dd.MM.yyyy HH:mm")
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">yok</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ---------- Ad soyad ---------- *@
    <div class="panel" style="margin-top:.7rem">
        <div class="panel-baslik">
            <span><i class="ph ph-user"></i> Ad soyad</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Hata))
        {
            <div class="bildirim bildirim-olumsuz"><i class="ph ph-warning"></i> @Model.Hata</div>
        }

        <form method="post" asp-action="AdSoyadGuncelle" class="arac-cubugu">
            @Html.AntiForgeryToken()

            <input class="form-control" style="width:20rem" name="yeniAdSoyad"
                   value="@Model.YeniAdSoyad" maxlength="100"
                   placeholder="Ad soyad" aria-label="Ad soyad" />

            <button type="submit" class="btn btn-primary">
                <i class="ph ph-check"></i> Kaydet
            </button>

        </form>
    </div>

    @* ---------- Şifre ----------
       id, hesap menüsündeki "Şifre değiştir" bağlantısının hedefi. *@
    <div class="panel" style="margin-top:.7rem" id="sifre">
        <div class="panel-baslik">
            <span><i class="ph ph-key"></i> Şifre değiştir</span>
            <span class="arac-sag">En az 8 karakter, harf ve rakam içermeli.</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.SifreHatasi))
        {
            <div class="bildirim bildirim-olumsuz"><i class="ph ph-warning"></i> @Model.SifreHatasi</div>
        }

        @* Alanlar bilerek bos donuyor: hata sonrasi sifreleri ekrana geri
           yazmak, onlari HTML kaynaginda gorunur kilardi. *@
        <form method="post" asp-action="SifreDegistir" class="arac-cubugu">
            @Html.AntiForgeryToken()

            <input class="form-control" style="width:13rem" type="password"
                   name="MevcutSifre" autocomplete="current-password"
                   placeholder="Mevcut şifre" aria-label="Mevcut şifre" />

            <input class="form-control" style="width:13rem" type="password"
                   name="YeniSifre" autocomplete="new-password"
                   placeholder="Yeni şifre" aria-label="Yeni şifre" />

            <input class="form-control" style="width:13rem" type="password"
                   name="YeniSifreTekrar" autocomplete="new-password"
                   placeholder="Yeni şifre (tekrar)" aria-label="Yeni şifre tekrar" />

            <button type="submit" class="btn btn-primary">
                <i class="ph ph-key"></i> Değiştir
            </button>
        </form>
    </div>

    <div class="durum-cubugu">
        <span>@Model.KullaniciAdi</span>
        <span>@Model.RolAdi</span>
    </div>
</div>
