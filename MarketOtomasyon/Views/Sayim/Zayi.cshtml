@model MarketOtomasyon.Models.ViewModels.ZayiEkranVm
@{
    ViewData["Title"] = "Zayi / Fire Girişi";
}

<div class="ekran">
    <div class="arac-cubugu">
        <a class="btn btn-secondary" asp-action="Index"><i class="ph ph-list-checks"></i> Sayım</a>
        <a class="btn btn-primary" asp-action="Zayi"><i class="ph ph-trash"></i> Zayi / Fire</a>
        <span class="arac-ayrac"></span>
        <span class="ipucu">Zayi kaydı stoktan çıkış yapar; sebep alanı zorunludur.</span>
    </div>

    @if (TempData["Mesaj"] is string mesaj)
    {
        <div class="bildirim bildirim-olumlu"><i class="ph ph-check-circle"></i> @mesaj</div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="bildirim bildirim-olumsuz">
            <i class="ph ph-warning"></i>
            <div asp-validation-summary="All" class="mb-0"></div>
        </div>
    }

    <div class="panel-serit" style="align-items:stretch">
        <div class="panel" style="flex:1 1 28rem">
            <div class="panel-baslik"><span><i class="ph ph-trash"></i> Yeni zayi / fire</span></div>
            <div class="panel-govde">
                <form id="zayi-form"
                      method="post"
                      asp-action="Zayi"
                      data-barkod-coz-url="@Url.Action("Coz", "Barkod")">
                    <div class="alan">
                        <label asp-for="Barkod">Barkod</label>
                        <div class="deger">
                            <div class="input-group">
                                <input id="barkod"
                                       class="form-control font-monospace"
                                       asp-for="Barkod"
                                       autocomplete="off"
                                       autofocus
                                       placeholder="Okutun, yazın veya kamerayı kullanın" />

                                <button type="button"
                                        id="btn-kamera"
                                        class="btn btn-secondary">
                                    <i class="ph ph-video-camera"></i> Kamera
                                </button>
                            </div>

                            <span class="hata" asp-validation-for="Barkod"></span>

                            <div id="zayi-urun-bilgi"
                                 class="bildirim bildirim-bilgi d-none mt-2"
                                 role="status"
                                 aria-live="polite"></div>
                        </div>
                    </div>

                    <div id="kamera-paneli"
                         class="arac-cubugu d-none mb-3"
                         style="background:#f8fafc">

                        <video id="kamera-video"
                               playsinline
                               muted
                               style="width:22rem;max-width:100%;height:12rem;object-fit:cover;background:#111827;border-radius:.25rem">
                        </video>

                        <div class="d-flex flex-column gap-1" style="min-width:0">
                            <span class="arac-etiket">Kamera</span>

                            <select id="kamera-secim"
                                    class="form-select"
                                    style="width:15rem"
                                    aria-label="Kamera seç">
                            </select>

                            <div id="kamera-durum" class="ipucu">Kamera kapalı.</div>
                            <div id="kamera-son" class="ipucu"></div>
                        </div>

                    </div>

                    <div class="alan">
                        <label asp-for="UrunId">Ürün</label>
                        <div class="deger">
                            <select class="form-select" asp-for="UrunId">
                                <option value="0">(barkod okutun veya seçiniz)</option>
                                @foreach (var urun in Model.Urunler)
                                {
                                    <option value="@urun.Id"
                                            data-kod="@urun.Kod"
                                            data-ad="@urun.Ad"
                                            data-birim="@urun.Birim"
                                            selected="@(Model.UrunId == urun.Id)">@urun.Kod · @urun.Ad</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="alan">
                        <label asp-for="DepoId">Depo</label>
                        <div class="deger">
                            <select class="form-select orta-genislik" asp-for="DepoId">
                                <option value="0">(seçiniz)</option>
                                @foreach (var depo in Model.Depolar)
                                {
                                    <option value="@depo.Id" selected="@(Model.DepoId == depo.Id)">@depo.Ad</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="alan">
                        <label asp-for="Miktar">Miktar</label>
                        <div class="deger">
                            <input class="form-control dar text-end" asp-for="Miktar" type="number" min="0" step="0.001" />
                        </div>
                    </div>
                    <div class="alan">
                        <label asp-for="Sebep">Sebep</label>
                        <div class="deger">
                            <textarea class="form-control" asp-for="Sebep" rows="3" maxlength="200"
                                      placeholder="Son kullanma tarihi, kırılma, bozulma vb."></textarea>
                        </div>
                    </div>
                    <div class="alan">
                        <label></label>
                        <div class="deger">
                            <button type="submit" class="btn btn-danger">
                                <i class="ph ph-check"></i> Zayiyi Kaydet
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div style="flex:2 1 34rem">
            <partial name="_Hareketler" model="Model.SonHareketler" />
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="~/lib/zxing/index.min.js" asp-append-version="true"></script>
    <script src="~/js/zayi-kamera.js" asp-append-version="true"></script>
    <script src="~/js/kamera.js" asp-append-version="true"></script>
}
