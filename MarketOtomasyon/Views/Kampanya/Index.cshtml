@model List<MarketOtomasyon.Models.ViewModels.KampanyaListeSatirVm>
@{
    ViewData["Title"] = "Kampanyalar";
    var yururlukte = Model.Count(k => k.SuAnGecerli);
}

<div class="ekran">
    @if (TempData["Mesaj"] is string mesaj)
    {
        <div class="bildirim bildirim-olumlu"><i class="ph ph-check-circle"></i> @mesaj</div>
    }

    <div class="bildirim bildirim-bilgi">
        <i class="ph ph-info"></i>
        <span>
            Kampanyalar kasada otomatik uygulanır. Bir satıra birden fazla kampanya uyuyorsa
            <strong>müşteri lehine en yüksek indirim</strong> seçilir; eşitlikte önceliği küçük olan kazanır.
            Elle indirim verilmiş satıra kampanya uygulanmaz.
        </span>
    </div>

    <div class="arac-cubugu">
        <a class="btn btn-primary" asp-action="Ekle">
            <i class="ph ph-plus"></i> Yeni Kampanya
        </a>
    </div>

    <div class="izgara-sarmal">
        <table class="izgara">
            <thead>
                <tr>
                    <th style="width:8rem">Kod</th>
                    <th>Ad</th>
                    <th style="width:10rem">Tip</th>
                    <th style="width:14rem">Kapsam</th>
                    <th class="sayi" style="width:6rem">Öncelik</th>
                    <th style="width:14rem">Geçerlilik</th>
                    <th style="width:8rem">Durum</th>
                    <th class="islem"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var kampanya in Model)
                {
                    <tr class="@(kampanya.Aktif ? "" : "pasif")">
                        <td class="kod">@kampanya.Kod</td>
                        <td>@kampanya.Ad</td>
                        <td>@kampanya.TipAdi</td>
                        <td class="text-muted">@kampanya.KapsamAdi</td>
                        <td class="sayi">@kampanya.Oncelik</td>
                        <td class="text-muted">
                            @kampanya.BaslangicTarihi.ToLocalTime().ToString("dd.MM.yyyy")
                            @if (kampanya.BitisTarihi.HasValue)
                            {
                                <text>– @kampanya.BitisTarihi.Value.ToLocalTime().ToString("dd.MM.yyyy")</text>
                            }
                            else
                            {
                                <text>– süresiz</text>
                            }
                        </td>
                        <td>
                            @if (kampanya.SuAnGecerli)
                            {
                                <span class="rozet rozet-olumlu">yürürlükte</span>
                            }
                            else if (!kampanya.Aktif)
                            {
                                <span class="rozet rozet-notr">pasif</span>
                            }
                            else
                            {
                                <span class="rozet rozet-uyari">tarih dışı</span>
                            }
                        </td>
                        <td class="islem">
                            <a class="btn btn-outline-primary" asp-action="Duzenle" asp-route-id="@kampanya.Id"
                               title="Düzenle"><i class="ph ph-pencil-simple"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.Count == 0)
        {
            <p class="veri-yok">Henüz kampanya tanımlanmamış.</p>
        }
    </div>

    <div class="durum-cubugu">
        <span><strong>@Model.Count</strong> kampanya</span>
        <span>@yururlukte tanesi şu an yürürlükte</span>
    </div>
</div>
