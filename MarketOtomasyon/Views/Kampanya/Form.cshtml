@model MarketOtomasyon.Models.ViewModels.KampanyaFormVm
@using MarketOtomasyon.Models.ViewModels
@{
    var yeniKayit = Model.Id == 0;
    ViewData["Title"] = yeniKayit ? "Yeni Kampanya" : "Kampanya Düzenle";
}

<form method="post" asp-action="@(yeniKayit ? "Ekle" : "Duzenle")" class="ekran">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="arac-cubugu">
        <button type="submit" class="btn btn-primary">
            <i class="ph ph-check"></i> Kaydet
        </button>
        <a class="btn btn-secondary" asp-action="Index">
            <i class="ph ph-x"></i> Vazgeç
        </a>
        <span class="arac-ayrac"></span>
        <span class="ipucu">Kampanyalar kasada otomatik uygulanır.</span>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="bildirim bildirim-olumsuz">
            <i class="ph ph-warning"></i>
            <div asp-validation-summary="All" class="mb-0"></div>
        </div>
    }

    <div class="izgara-sarmal">
        <div class="form-ekran">

            <div class="bolum">
                <div class="bolum-baslik">Tanım</div>

                <div class="alan">
                    <label asp-for="Kod">Kod</label>
                    <div class="deger">
                        <input class="form-control dar font-monospace" asp-for="Kod" />
                        <span class="hata" asp-validation-for="Kod"></span>
                    </div>
                </div>

                <div class="alan">
                    <label asp-for="Ad">Kampanya adı</label>
                    <div class="deger">
                        <input class="form-control" asp-for="Ad" style="max-width:32rem"
                               placeholder="Kasa ekranında ve fişte bu ad görünür" />
                        <span class="hata" asp-validation-for="Ad"></span>
                    </div>
                </div>

                @* Tip secimi alttaki alanlari acip kapatir; ilgisiz alan hic gorunmez. *@
                <div class="alan">
                    <label>Kampanya tipi</label>
                    <div class="deger">
                        <div class="btn-group btn-group-sm" role="group">
                            <input type="radio" class="btn-check" name="KampanyaTipi" id="tip-yuzde"
                                   value="@KampanyaFormVm.TipYuzdeIndirim"
                                   checked="@(Model.KampanyaTipi == KampanyaFormVm.TipYuzdeIndirim)" />
                            <label class="btn btn-outline-primary" for="tip-yuzde">Yüzde indirim</label>

                            <input type="radio" class="btn-check" name="KampanyaTipi" id="tip-tutar"
                                   value="@KampanyaFormVm.TipTutarIndirimi"
                                   checked="@(Model.KampanyaTipi == KampanyaFormVm.TipTutarIndirimi)" />
                            <label class="btn btn-outline-primary" for="tip-tutar">Tutar indirimi</label>

                            <input type="radio" class="btn-check" name="KampanyaTipi" id="tip-nalm"
                                   value="@KampanyaFormVm.TipNAlMOde"
                                   checked="@(Model.KampanyaTipi == KampanyaFormVm.TipNAlMOde)" />
                            <label class="btn btn-outline-primary" for="tip-nalm">N al M öde</label>

                            <input type="radio" class="btn-check" name="KampanyaTipi" id="tip-baraj"
                                   value="@KampanyaFormVm.TipTutarBaraji"
                                   checked="@(Model.KampanyaTipi == KampanyaFormVm.TipTutarBaraji)" />
                            <label class="btn btn-outline-primary" for="tip-baraj">Tutar barajı</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bolum kapsam-alani">
                <div class="bolum-baslik">Kapsam</div>

                <div class="alan">
                    <label>Uygulanacağı</label>
                    <div class="deger d-flex align-items-center gap-2 flex-wrap">
                        <select class="form-select" style="width:9rem" asp-for="Kapsam" id="kapsam-secim">
                            <option value="@KampanyaFormVm.KapsamUrun">Tek ürün</option>
                            <option value="@KampanyaFormVm.KapsamKategori">Kategori</option>
                        </select>

                        <span class="kapsam-urun">
                            <select class="form-select" style="width:24rem" asp-for="UrunId">
                                <option value="">(ürün seçiniz)</option>
                                @foreach (var urun in Model.Urunler)
                                {
                                    <option value="@urun.Id" selected="@(Model.UrunId == urun.Id)">@urun.Kod — @urun.Ad</option>
                                }
                            </select>
                            <span class="hata" asp-validation-for="UrunId"></span>
                        </span>

                        <span class="kapsam-kategori">
                            <select class="form-select" style="width:24rem" asp-for="KategoriId">
                                <option value="">(kategori seçiniz)</option>
                                @foreach (var kategori in Model.Kategoriler)
                                {
                                    <option value="@kategori.Id" selected="@(Model.KategoriId == kategori.Id)">@kategori.Ad</option>
                                }
                            </select>
                            <span class="hata" asp-validation-for="KategoriId"></span>
                        </span>
                    </div>
                </div>
            </div>

            <div class="bolum">
                <div class="bolum-baslik">Koşul ve indirim</div>

                <div class="alan alan-yuzde">
                    <label asp-for="Yuzde">İndirim oranı</label>
                    <div class="deger d-flex align-items-center gap-2">
                        <input class="form-control dar text-end" asp-for="Yuzde"
                               type="number" step="0.01" min="0" max="100" />
                        <span class="ipucu">%</span>
                        <span class="hata" asp-validation-for="Yuzde"></span>
                    </div>
                </div>

                <div class="alan alan-tutar">
                    <label asp-for="Tutar">İndirim tutarı</label>
                    <div class="deger d-flex align-items-center gap-2">
                        <input class="form-control dar text-end" asp-for="Tutar"
                               type="number" step="0.01" min="0" />
                        <span class="ipucu">₺</span>
                        <span class="hata" asp-validation-for="Tutar"></span>
                    </div>
                </div>

                <div class="alan alan-nalm">
                    <label asp-for="AlinacakMiktar">Alınacak (N)</label>
                    <div class="deger">
                        <input class="form-control dar text-end" asp-for="AlinacakMiktar"
                               type="number" step="1" min="2" />
                        <span class="hata" asp-validation-for="AlinacakMiktar"></span>
                    </div>
                </div>

                <div class="alan alan-nalm">
                    <label asp-for="OdenecekMiktar">Ödenecek (M)</label>
                    <div class="deger d-flex align-items-center gap-2">
                        <input class="form-control dar text-end" asp-for="OdenecekMiktar"
                               type="number" step="1" min="1" />
                        <span class="ipucu">3 al 2 öde için N=3, M=2</span>
                        <span class="hata" asp-validation-for="OdenecekMiktar"></span>
                    </div>
                </div>

                <div class="alan alan-baraj">
                    <label asp-for="MinSepetTutari">Baraj tutarı</label>
                    <div class="deger d-flex align-items-center gap-2">
                        <input class="form-control dar text-end" asp-for="MinSepetTutari"
                               type="number" step="0.01" min="0" />
                        <span class="ipucu">₺ — sepet bu tutarı geçince indirim uygulanır</span>
                        <span class="hata" asp-validation-for="MinSepetTutari"></span>
                    </div>
                </div>
            </div>

            <div class="bolum">
                <div class="bolum-baslik">Geçerlilik</div>

                <div class="alan">
                    <label asp-for="BaslangicTarihi">Başlangıç</label>
                    <div class="deger">
                        <input class="form-control orta-genislik" asp-for="BaslangicTarihi" type="date" />
                    </div>
                </div>

                <div class="alan">
                    <label asp-for="BitisTarihi">Bitiş</label>
                    <div class="deger d-flex align-items-center gap-2">
                        <input class="form-control orta-genislik" asp-for="BitisTarihi" type="date" />
                        <span class="ipucu">boş bırakılırsa süresiz</span>
                        <span class="hata" asp-validation-for="BitisTarihi"></span>
                    </div>
                </div>

                <div class="alan">
                    <label asp-for="Oncelik">Öncelik</label>
                    <div class="deger d-flex align-items-center gap-2">
                        <input class="form-control dar text-end" asp-for="Oncelik" type="number" step="1" />
                        <span class="ipucu">küçük olan önce uygulanır</span>
                    </div>
                </div>

                <div class="alan">
                    <label>Seçenekler</label>
                    <div class="deger d-flex align-items-center gap-4 flex-wrap">
                        <div class="form-check mb-0">
                            <input class="form-check-input" asp-for="Aktif" />
                            <label class="form-check-label" asp-for="Aktif">Aktif</label>
                        </div>
                        <div class="form-check mb-0">
                            <input class="form-check-input" asp-for="DigerleriyleBirlesir" />
                            <label class="form-check-label" asp-for="DigerleriyleBirlesir">Diğerleriyle birleşir</label>
                        </div>
                    </div>
                </div>

                <div class="alan">
                    <label></label>
                    <div class="deger ipucu">
                        "Diğerleriyle birleşir" işaretlenirse, bu kampanyanın uygulandığı satıra sepet barajı
                        indirimi de eklenebilir. İşaretlenmezse o satır yalnızca bu kampanyayı alır.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="durum-cubugu">
        <span>@(yeniKayit ? "Yeni kampanya" : $"Kampanya #{Model.Id}")</span>
        <span class="arac-sag">
            Bir satıra birden fazla kampanya uyarsa müşteri lehine en yüksek indirim seçilir.
        </span>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Kampanya tipine gore ilgisiz alanlar gizlenir; kullanici yalnizca
        // secilen tip icin anlamli olan alanlari gorur.
        (function () {
            "use strict";

            const TIP_YUZDE = "@KampanyaFormVm.TipYuzdeIndirim";
            const TIP_TUTAR = "@KampanyaFormVm.TipTutarIndirimi";
            const TIP_NALM = "@KampanyaFormVm.TipNAlMOde";
            const TIP_BARAJ = "@KampanyaFormVm.TipTutarBaraji";

            function goster(secici, gorunur) {
                document.querySelectorAll(secici).forEach(e => e.classList.toggle("d-none", !gorunur));
            }

            function tipDegisti() {
                const tip = document.querySelector('input[name="KampanyaTipi"]:checked').value;

                goster(".kapsam-alani", tip !== TIP_BARAJ);
                goster(".alan-yuzde", tip === TIP_YUZDE || tip === TIP_BARAJ);
                goster(".alan-tutar", tip === TIP_TUTAR);
                goster(".alan-nalm", tip === TIP_NALM);
                goster(".alan-baraj", tip === TIP_BARAJ);
            }

            function kapsamDegisti() {
                const kapsam = document.getElementById("kapsam-secim").value;
                goster(".kapsam-urun", kapsam === "@KampanyaFormVm.KapsamUrun");
                goster(".kapsam-kategori", kapsam === "@KampanyaFormVm.KapsamKategori");
            }

            document.querySelectorAll('input[name="KampanyaTipi"]')
                .forEach(g => g.addEventListener("change", tipDegisti));
            document.getElementById("kapsam-secim").addEventListener("change", kapsamDegisti);

            tipDegisti();
            kapsamDegisti();
        })();
    </script>
}
