@model MarketOtomasyon.Models.ViewModels.UrunDetayVm
@using MarketOtomasyon.Models.ViewModels
@{
    ViewData["Title"] = Model.Urun.Ad;
}

<div class="ekran">
    <div class="arac-cubugu">
        <a class="btn btn-outline-secondary" asp-action="Index">
            <i class="bi bi-arrow-left"></i> Liste
        </a>
        <a class="btn btn-primary" asp-action="Duzenle" asp-route-id="@Model.Urun.Id">
            <i class="bi bi-pencil"></i> Düzenle
        </a>

        <span class="arac-ayrac"></span>

        <span class="kod">@Model.Urun.Kod</span>
        <strong>@Model.Urun.Ad</strong>
        <span class="text-muted">
            @Model.Urun.Birim · KDV %@Model.Urun.KdvOrani.ToString("0.##")
        </span>
        @if (Model.Urun.Tartili)
        {
            <span class="rozet rozet-notr">tartılı</span>
        }
        @if (Model.Urun.Aktif)
        {
            <span class="rozet rozet-olumlu">aktif</span>
        }
        else
        {
            <span class="rozet rozet-notr">pasif</span>
        }

        @if (Model.GuncelFiyat is not null)
        {
            <div class="arac-sag d-flex align-items-center gap-2">
                <span class="arac-etiket">Güncel fiyat</span>
                <strong class="fs-5">@Model.GuncelFiyat.Value.ToString("N2") ₺</strong>
            </div>
        }
    </div>

    @if (TempData["Mesaj"] is string mesaj)
    {
        <div class="bildirim bildirim-olumlu"><i class="bi bi-check-circle"></i> @mesaj</div>
    }

    <div class="panel-serit" style="flex:1; min-height:0; align-items:stretch">

        <!-- Fotograf -->
        <div class="panel" style="flex:0 1 16rem">
            <div class="panel-baslik"><span><i class="bi bi-image"></i> Fotoğraf</span></div>
            <div class="panel-govde text-center">
                <partial name="_UrunResmi"
                         model="@UrunResmiVm.Olustur(Model.Urun.ResimYolu, Model.Urun.Ad, "dev")" />

                @* Kaynak yalnizca ucuncu taraf bir fotograf indirildiginde
                   gosterilir (CC-BY-SA atif yukumlulugu). Yerel ikonlarda
                   ResimKaynagi bos kalir -- atif gerekmez, kutu da cikmaz. *@
                @if (!string.IsNullOrWhiteSpace(Model.Urun.ResimKaynagi))
                {
                    <div class="resim-kaynak mt-2">
                        @Model.Urun.ResimKaynagi
                        @if (Model.Urun.ResimTarihi is not null)
                        {
                            <br />
                            <text>@Model.Urun.ResimTarihi.Value.ToLocalTime().ToString("dd.MM.yyyy") tarihinde indirildi</text>
                        }
                    </div>
                }
                else if (string.IsNullOrWhiteSpace(Model.Urun.ResimYolu))
                {
                    <div class="resim-kaynak mt-2">
                        Görsel yok. Ürün listesindeki <strong>Resimleri Çek</strong>
                        düğmesi barkodu olan ürünler için dener.
                    </div>
                }
            </div>
        </div>

        <!-- Barkodlar -->
        <div class="panel" style="flex:3 1 28rem">
            <div class="panel-baslik"><span><i class="bi bi-upc-scan"></i> Barkodlar</span></div>

            <div class="izgara-sarmal">
                <table class="izgara">
                    <thead>
                        <tr>
                            <th>Barkod</th>
                            <th style="width:6rem">Tip</th>
                            <th class="sayi" style="width:7rem">Çarpan</th>
                            <th class="islem"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var barkod in Model.Barkodlar)
                        {
                            <tr>
                                <td class="kod">@barkod.Barkod</td>
                                <td>
                                    @if (barkod.Tip == 2)
                                    {
                                        <span class="rozet rozet-uyari">koli</span>
                                    }
                                    else
                                    {
                                        <span class="rozet rozet-notr">tekli</span>
                                    }
                                </td>
                                <td class="sayi">@barkod.Carpan.ToString("0.##")</td>
                                <td class="islem">
                                    <form method="post" asp-action="BarkodSil">
                                        <input type="hidden" name="id" value="@barkod.Id" />
                                        <input type="hidden" name="urunId" value="@Model.Urun.Id" />
                                        <button type="submit" class="btn btn-outline-danger" title="Barkodu sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (Model.Barkodlar.Count == 0)
                {
                    <p class="veri-yok">Bu ürüne henüz barkod tanımlanmamış.</p>
                }
            </div>

            @* Ekleme satiri izgaranin hemen altinda: yeni barkod, listenin
               devami gibi girilir. *@
            <form method="post" asp-action="BarkodEkle" class="arac-cubugu"
                  style="border-top:1px solid var(--izgara-cizgi); border-bottom:none">
                <input type="hidden" asp-for="YeniBarkod.UrunId" value="@Model.Urun.Id" />

                <span class="arac-etiket">Yeni</span>
                <input class="form-control font-monospace" style="width:13rem"
                       asp-for="YeniBarkod.Barkod" autocomplete="off"
                       placeholder="Barkod" aria-label="Barkod" />

                <select class="form-select" style="width:7rem" asp-for="YeniBarkod.Tip" aria-label="Barkod tipi">
                    <option value="1">Tekli</option>
                    <option value="2">Koli</option>
                </select>

                <input class="form-control text-end" style="width:6rem" asp-for="YeniBarkod.Carpan"
                       type="number" step="0.001" min="0" placeholder="Çarpan" aria-label="Çarpan" />

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i> Ekle
                </button>

                <span class="hata" asp-validation-for="YeniBarkod.Barkod"></span>
                <span class="hata" asp-validation-for="YeniBarkod.Carpan"></span>

                <span class="ipucu arac-sag">
                    Koli barkodunda çarpan, bir okutmada sepete eklenecek adettir (12'li koli → 12).
                </span>
            </form>
        </div>

        <!-- Fiyat gecmisi -->
        <div class="panel" style="flex:2 1 22rem">
            <div class="panel-baslik"><span><i class="bi bi-clock-history"></i> Fiyat geçmişi</span></div>

            <div class="izgara-sarmal">
                <table class="izgara">
                    <thead>
                        <tr>
                            <th class="sayi" style="width:7rem">Fiyat</th>
                            <th>Başlangıç</th>
                            <th>Bitiş</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fiyat in Model.FiyatGecmisi)
                        {
                            <tr>
                                <td class="sayi fw-semibold">@fiyat.Fiyat.ToString("N2")</td>
                                <td>@fiyat.BaslangicTarihi.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    @if (fiyat.Guncel)
                                    {
                                        <span class="rozet rozet-olumlu">güncel</span>
                                    }
                                    else
                                    {
                                        @fiyat.BitisTarihi!.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (Model.FiyatGecmisi.Count == 0)
                {
                    <p class="veri-yok">Fiyat kaydı yok.</p>
                }
            </div>
        </div>
    </div>

    <div class="durum-cubugu">
        <span><strong>@Model.Barkodlar.Count</strong> barkod</span>
        <span><strong>@Model.FiyatGecmisi.Count</strong> fiyat kaydı</span>
        <span class="arac-sag">Fiyat düzenleme ekranından değişir; eski kayıt silinmez, bitiş tarihi dolar.</span>
    </div>
</div>
