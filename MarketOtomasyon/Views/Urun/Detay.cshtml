@model MarketOtomasyon.Models.ViewModels.UrunDetayVm
@{
    ViewData["Title"] = Model.Urun.Ad;
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <div class="text-muted">
            <code>@Model.Urun.Kod</code>
            &middot; @Model.Urun.Birim
            &middot; KDV %@Model.Urun.KdvOrani.ToString("0.##")
            @if (Model.Urun.Tartili)
            {
                <span class="badge bg-info">tartılı</span>
            }
            @if (!Model.Urun.Aktif)
            {
                <span class="badge bg-secondary">pasif</span>
            }
        </div>
    </div>
    <div>
        <a class="btn btn-outline-primary" asp-action="Duzenle" asp-route-id="@Model.Urun.Id">Düzenle</a>
        <a class="btn btn-link" asp-action="Index">Listeye dön</a>
    </div>
</div>

@if (TempData["Mesaj"] is string mesaj)
{
    <div class="alert alert-success">@mesaj</div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">Barkodlar</div>
            <div class="card-body">
                <table class="table table-sm align-middle mb-3">
                    <thead>
                        <tr>
                            <th>Barkod</th>
                            <th>Tip</th>
                            <th class="text-end">Çarpan</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Barkodlar.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">Bu ürüne henüz barkod tanımlanmamış.</td></tr>
                        }
                        @foreach (var b in Model.Barkodlar)
                        {
                            <tr>
                                <td><code>@b.Barkod</code></td>
                                <td>
                                    @if (b.Tip == 2)
                                    {
                                        <span class="badge bg-warning text-dark">koli</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark">tekli</span>
                                    }
                                </td>
                                <td class="text-end">@b.Carpan.ToString("0.##")</td>
                                <td class="text-end">
                                    <form method="post" asp-action="BarkodSil">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@b.Id" />
                                        <input type="hidden" name="urunId" value="@Model.Urun.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <h6 class="text-muted">Yeni barkod ekle</h6>
                <form method="post" asp-action="BarkodEkle" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="YeniBarkod.UrunId" value="@Model.Urun.Id" />

                    <div class="col-md-5">
                        <label class="form-label">Barkod</label>
                        <input class="form-control" asp-for="YeniBarkod.Barkod" autocomplete="off" />
                        <span class="text-danger small" asp-validation-for="YeniBarkod.Barkod"></span>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Tip</label>
                        <select class="form-select" asp-for="YeniBarkod.Tip">
                            <option value="1">Tekli</option>
                            <option value="2">Koli</option>
                        </select>
                        <span class="text-danger small" asp-validation-for="YeniBarkod.Tip"></span>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Çarpan</label>
                        <input class="form-control" asp-for="YeniBarkod.Carpan" type="number" step="0.001" min="0" />
                        <span class="text-danger small" asp-validation-for="YeniBarkod.Carpan"></span>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">Ekle</button>
                    </div>
                </form>
                <div class="form-text mt-2">
                    Koli barkodunda çarpan, bir okutmada sepete eklenecek adedi belirtir (örn. 12'li koli için 12).
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Fiyat geçmişi</span>
                @if (Model.GuncelFiyat is not null)
                {
                    <strong>@Model.GuncelFiyat.Value.ToString("N2") TL</strong>
                }
            </div>
            <div class="card-body">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th class="text-end">Fiyat</th>
                            <th>Başlangıç</th>
                            <th>Bitiş</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.FiyatGecmisi.Count == 0)
                        {
                            <tr><td colspan="3" class="text-center text-muted py-3">Fiyat kaydı yok.</td></tr>
                        }
                        @foreach (var f in Model.FiyatGecmisi)
                        {
                            <tr class="@(f.Guncel ? "table-success" : null)">
                                <td class="text-end">@f.Fiyat.ToString("N2")</td>
                                <td>@f.BaslangicTarihi.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    @if (f.Guncel)
                                    {
                                        <span class="badge bg-success">güncel</span>
                                    }
                                    else
                                    {
                                        @f.BitisTarihi!.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="form-text mt-2">
                    Fiyat, ürün düzenleme ekranından değiştirilir. Eski kayıt silinmez, bitiş tarihi doldurulur.
                </div>
            </div>
        </div>
    </div>
</div>
