@model MarketOtomasyon.Models.ViewModels.UrunFormVm
@{
    var yeniKayit = Model.Id == 0;
    ViewData["Title"] = yeniKayit ? "Yeni Ürün" : "Ürün Düzenle";
}

<form method="post" asp-action="@(yeniKayit ? "Ekle" : "Duzenle")" class="row g-3" style="max-width: 720px;">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All" class="alert alert-danger @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>

    <div class="col-md-4">
        <label class="form-label" asp-for="Kod">Kod</label>
        <input class="form-control" asp-for="Kod" />
        <span class="text-danger small" asp-validation-for="Kod"></span>
    </div>

    <div class="col-md-8">
        <label class="form-label" asp-for="Ad">Ad</label>
        <input class="form-control" asp-for="Ad" />
        <span class="text-danger small" asp-validation-for="Ad"></span>
    </div>

    <div class="col-md-4">
        <label class="form-label" asp-for="KategoriId">Kategori</label>
        <select class="form-select" asp-for="KategoriId">
            <option value="0">(seçiniz)</option>
            @foreach (var k in Model.Kategoriler)
            {
                <option value="@k.Id" selected="@(Model.KategoriId == k.Id)">@k.Ad</option>
            }
        </select>
        <span class="text-danger small" asp-validation-for="KategoriId"></span>
    </div>

    <div class="col-md-4">
        <label class="form-label" asp-for="Birim">Birim</label>
        <select class="form-select" asp-for="Birim">
            <option value="ADET">ADET</option>
            <option value="KG">KG</option>
        </select>
        <span class="text-danger small" asp-validation-for="Birim"></span>
    </div>

    <div class="col-md-4">
        <label class="form-label" asp-for="KdvOrani">KDV Oranı (%)</label>
        <select class="form-select" asp-for="KdvOrani">
            <option value="0">0</option>
            <option value="1">1</option>
            <option value="10">10</option>
            <option value="20">20</option>
        </select>
        <span class="text-danger small" asp-validation-for="KdvOrani"></span>
    </div>

    <div class="col-md-4">
        <label class="form-label" asp-for="Fiyat">Satış Fiyatı</label>
        <input class="form-control" asp-for="Fiyat" type="number" step="0.01" min="0" />
        <span class="text-danger small" asp-validation-for="Fiyat"></span>
        @if (!yeniKayit)
        {
            <div class="form-text">Değiştirirseniz eski fiyat geçmişte saklanır.</div>
        }
    </div>

    <div class="col-md-4">
        <label class="form-label" asp-for="MinStokSeviyesi">Min. Stok</label>
        <input class="form-control" asp-for="MinStokSeviyesi" type="number" step="0.001" min="0" />
        <span class="text-danger small" asp-validation-for="MinStokSeviyesi"></span>
    </div>

    <div class="col-md-4 d-flex align-items-end gap-4">
        <div class="form-check">
            <input class="form-check-input" asp-for="Tartili" />
            <label class="form-check-label" asp-for="Tartili">Tartılı</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" asp-for="Aktif" />
            <label class="form-check-label" asp-for="Aktif">Aktif</label>
        </div>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a class="btn btn-link" asp-action="Index">Vazgeç</a>
    </div>
</form>
