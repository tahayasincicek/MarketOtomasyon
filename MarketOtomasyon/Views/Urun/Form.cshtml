@model MarketOtomasyon.Models.ViewModels.UrunFormVm
@{
    var yeniKayit = Model.Id == 0;
    ViewData["Title"] = yeniKayit ? "Yeni Ürün" : "Ürün Düzenle";
}

<form method="post" asp-action="@(yeniKayit ? "Ekle" : "Duzenle")" class="ekran">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    @* Kaydet/vazgec ustte: kayit ekranlarinda dugmeler hep ayni yerde
       olsun, form uzadikca asagi kaymasin. *@
    <div class="arac-cubugu">
        <button type="submit" class="btn btn-primary">
            <i class="ph ph-check"></i> Kaydet
        </button>
        <a class="btn btn-secondary" asp-action="Index">
            <i class="ph ph-x"></i> Vazgeç
        </a>
        @if (!yeniKayit)
        {
            <span class="arac-ayrac"></span>
            <a class="btn btn-secondary" asp-action="Detay" asp-route-id="@Model.Id">
                <i class="ph ph-list-bullets"></i> Detay
            </a>
        }
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="bildirim bildirim-olumsuz">
            <i class="ph ph-warning"></i>
            <div asp-validation-summary="All" class="mb-0"></div>
        </div>
    }

    <div class="izgara-sarmal">
        <div class="form-ekran">
            <div class="bolum">
                <div class="bolum-baslik">Tanım</div>

                <div class="alan">
                    <label asp-for="Kod">Kod</label>
                    <div class="deger">
                        <input class="form-control dar font-monospace" asp-for="Kod" />
                        <span class="hata" asp-validation-for="Kod"></span>
                    </div>
                </div>

                <div class="alan">
                    <label asp-for="Ad">Ad</label>
                    <div class="deger">
                        <input class="form-control" asp-for="Ad" style="max-width:30rem" />
                        <span class="hata" asp-validation-for="Ad"></span>
                    </div>
                </div>

                <div class="alan">
                    <label asp-for="KategoriId">Kategori</label>
                    <div class="deger">
                        <select class="form-select orta-genislik" asp-for="KategoriId">
                            <option value="0">(seçiniz)</option>
                            @foreach (var kategori in Model.Kategoriler)
                            {
                                <option value="@kategori.Id" selected="@(Model.KategoriId == kategori.Id)">@kategori.Ad</option>
                            }
                        </select>
                        <span class="hata" asp-validation-for="KategoriId"></span>
                    </div>
                </div>

                <div class="alan">
                    <label asp-for="Birim">Birim</label>
                    <div class="deger">
                        <select class="form-select dar" asp-for="Birim">
                            <option value="ADET">ADET</option>
                            <option value="KG">KG</option>
                        </select>
                        <span class="hata" asp-validation-for="Birim"></span>
                    </div>
                </div>
            </div>

            <div class="bolum">
                <div class="bolum-baslik">Fiyat ve vergi</div>

                <div class="alan">
                    <label asp-for="KdvOrani">KDV oranı</label>
                    <div class="deger d-flex align-items-center gap-2">
                        <select class="form-select dar" asp-for="KdvOrani">
                            <option value="0">0</option>
                            <option value="1">1</option>
                            <option value="10">10</option>
                            <option value="20">20</option>
                        </select>
                        <span class="ipucu">%</span>
                        <span class="hata" asp-validation-for="KdvOrani"></span>
                    </div>
                </div>

                <div class="alan">
                    <label asp-for="Fiyat">Satış fiyatı</label>
                    <div class="deger d-flex align-items-center gap-2">
                        <input class="form-control dar text-end" asp-for="Fiyat" type="number" step="0.01" min="0" />
                        <span class="ipucu">₺ (KDV dahil)</span>
                        <span class="hata" asp-validation-for="Fiyat"></span>
                    </div>
                </div>

                @if (!yeniKayit)
                {
                    <div class="alan">
                        <label></label>
                        <div class="deger ipucu">Fiyatı değiştirirseniz eski fiyat geçmişte saklanır.</div>
                    </div>
                }
            </div>

            <div class="bolum">
                <div class="bolum-baslik">Stok ve seçenekler</div>

                <div class="alan">
                    <label asp-for="MinStokSeviyesi">Min. stok</label>
                    <div class="deger d-flex align-items-center gap-2">
                        <input class="form-control dar text-end" asp-for="MinStokSeviyesi"
                               type="number" step="0.001" min="0" />
                        <span class="ipucu">bu seviyenin altı stok ekranında kritik gösterilir</span>
                        <span class="hata" asp-validation-for="MinStokSeviyesi"></span>
                    </div>
                </div>

                <div class="alan">
                    <label>Seçenekler</label>
                    <div class="deger d-flex align-items-center gap-4">
                        <div class="form-check mb-0">
                            <input class="form-check-input" asp-for="Tartili" />
                            <label class="form-check-label" asp-for="Tartili">Tartılı</label>
                        </div>
                        <div class="form-check mb-0">
                            <input class="form-check-input" asp-for="Aktif" />
                            <label class="form-check-label" asp-for="Aktif">Aktif</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="durum-cubugu">
        <span>@(yeniKayit ? "Yeni kayıt" : $"Kayıt #{Model.Id}")</span>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
