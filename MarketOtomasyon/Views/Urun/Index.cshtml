@model MarketOtomasyon.Models.ViewModels.UrunListeVm
@using MarketOtomasyon.Models.ViewModels
@{
    ViewData["Title"] = "Ürünler";
    var resimsiz = Model.Satirlar.Count(s => string.IsNullOrWhiteSpace(s.ResimYolu));
}

<div class="ekran">
    @if (TempData["Mesaj"] is string mesaj)
    {
        <div class="bildirim bildirim-olumlu"><i class="ph ph-check-circle"></i> @mesaj</div>
    }

    @if (TempData["Uyari"] is string uyari)
    {
        <div class="bildirim bildirim-olumsuz"><i class="ph ph-warning"></i> @uyari</div>
    }

    @* Eylemler ve filtreler tek seritte. Icerideki iki form "display: contents"
       ile serit duzenini bozmaz; ayri formlar cunku biri GET (filtre), digeri
       POST (resim cekme) ve POST'un antiforgery token'i olmali. *@
    <div class="arac-cubugu">
        <a class="btn btn-primary" asp-action="Ekle">
            <i class="ph ph-plus"></i> Yeni Ürün
        </a>

        <form method="post" asp-action="ResimleriCek" class="form-seffaf">
            <button type="submit" class="btn btn-outline-secondary"
                    title="Barkodu olan ürünlerin fotoğrafını Open Food Facts'ten çeker">
                <i class="ph ph-image"></i> Resimleri Çek
            </button>
        </form>

        <span class="arac-ayrac"></span>

        <form method="get" asp-action="Index" class="form-seffaf">
            <div class="arac-alan">
                <i class="ph ph-magnifying-glass text-muted"></i>
                <input name="arama" value="@Model.Arama" class="form-control" style="width:15rem"
                       placeholder="Kod veya ad ara" aria-label="Kod veya ad ara" autofocus />
            </div>

            <select name="kategoriId" class="form-select" style="width:11rem" aria-label="Kategori">
                <option value="">Tüm kategoriler</option>
                @foreach (var kategori in Model.Kategoriler)
                {
                    <option value="@kategori.Id" selected="@(Model.KategoriId == kategori.Id)">@kategori.Ad</option>
                }
            </select>

            <div class="form-check ms-1">
                <input type="checkbox" name="sadeceAktif" value="true" class="form-check-input"
                       id="sadeceAktif" checked="@Model.SadeceAktif" />
                <label class="form-check-label small" for="sadeceAktif">Sadece aktif</label>
            </div>

            <button type="submit" class="btn btn-outline-secondary">Uygula</button>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.Arama) || Model.KategoriId is not null)
        {
            <a class="btn btn-link btn-sm" asp-action="Index">Temizle</a>
        }
    </div>

    <div class="izgara-sarmal">
        <table class="izgara">
            <thead>
                <tr>
                    <th style="width:8rem">Kod</th>
                    <th>Ad</th>
                    <th style="width:11rem">Kategori</th>
                    <th style="width:5rem">Birim</th>
                    <th class="sayi" style="width:5rem">KDV</th>
                    <th class="sayi" style="width:7rem">Fiyat</th>
                    <th style="width:6rem">Durum</th>
                    <th class="islem"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var urun in Model.Satirlar)
                {
                    <tr class="@(urun.Aktif ? "" : "pasif")">
                        <td class="kod">@urun.Kod</td>
                        <td>
                            <span class="urun-hucre">
                                <partial name="_UrunResmi"
                                         model="@UrunResmiVm.Olustur(urun.ResimYolu, urun.Ad, "kucuk", urun.KategoriAd)" />
                                <span class="urun-hucre-metin">
                                    @urun.Ad
                                    @if (urun.Tartili)
                                    {
                                        <span class="rozet rozet-notr ms-1">tartılı</span>
                                    }
                                </span>
                            </span>
                        </td>
                        <td>@urun.KategoriAd</td>
                        <td>@urun.Birim</td>
                        <td class="sayi">%@urun.KdvOrani.ToString("0.##")</td>
                        <td class="sayi">@(urun.GuncelFiyat?.ToString("N2") ?? "—")</td>
                        <td>
                            @if (urun.Aktif)
                            {
                                <span class="rozet rozet-olumlu">aktif</span>
                            }
                            else
                            {
                                <span class="rozet rozet-notr">pasif</span>
                            }
                        </td>
                        <td class="islem">
                            <a class="btn btn-outline-secondary" asp-action="Detay" asp-route-id="@urun.Id"
                               title="Detay"><i class="ph ph-list-bullets"></i></a>
                            <a class="btn btn-outline-primary" asp-action="Duzenle" asp-route-id="@urun.Id"
                               title="Düzenle"><i class="ph ph-pencil-simple"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.Satirlar.Count == 0)
        {
            <p class="veri-yok">Aramanıza uyan ürün bulunamadı.</p>
        }
    </div>

    <div class="durum-cubugu">
        <span><strong>@Model.ToplamKayit</strong> kayıt</span>
        <span>Sayfa @Model.Sayfa / @Model.ToplamSayfa</span>
        @if (resimsiz > 0)
        {
            <span class="rozet rozet-notr">bu sayfada @resimsiz ürünün fotoğrafı yok</span>
        }

        <div class="arac-sag d-flex align-items-center gap-2">
            <ul class="pagination pagination-sm">
                <li class="page-item @(Model.OncekiVar ? "" : "disabled")">
                    <a class="page-link" asp-action="Index"
                       asp-route-arama="@Model.Arama"
                       asp-route-kategoriId="@Model.KategoriId"
                       asp-route-sadeceAktif="@Model.SadeceAktif"
                       asp-route-sayfa="@(Model.Sayfa - 1)">‹ Önceki</a>
                </li>
                <li class="page-item @(Model.SonrakiVar ? "" : "disabled")">
                    <a class="page-link" asp-action="Index"
                       asp-route-arama="@Model.Arama"
                       asp-route-kategoriId="@Model.KategoriId"
                       asp-route-sadeceAktif="@Model.SadeceAktif"
                       asp-route-sayfa="@(Model.Sayfa + 1)">Sonraki ›</a>
                </li>
            </ul>
        </div>
    </div>
</div>
