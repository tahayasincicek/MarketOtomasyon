@model MarketOtomasyon.Models.ViewModels.IadeAramaVm
@using System.Globalization
@{
    ViewData["Title"] = "İade";
    var tr = new CultureInfo("tr-TR");
    string Para(decimal deger) => deger.ToString("N2", tr);
}

@if (TempData["Mesaj"] is string mesaj)
{
    <div class="alert alert-success">@mesaj</div>
}

<div class="card mb-4">
    <div class="card-header">Satış fişini bul</div>
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-6 col-lg-4">
                <label class="form-label" for="fisNo">Fiş numarası</label>
                <input class="form-control font-monospace" id="fisNo" name="fisNo" value="@Model.FisNo"
                       autocomplete="off" autofocus placeholder="20260820-00001" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Satışı Bul
                </button>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Hata))
{
    <div class="alert alert-danger">@Model.Hata</div>
}

@if (Model.Fis is not null)
{
    var fis = Model.Fis;

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Fiş <strong class="font-monospace">@fis.FisNo</strong></span>
            <span class="badge bg-light text-dark">@fis.Tarih.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-3">
                <div class="col-sm-4">
                    <div class="text-muted small">Satış toplamı</div>
                    <div class="fs-5 fw-semibold">@Para(fis.GenelToplam) ₺</div>
                </div>
                <div class="col-sm-4">
                    <div class="text-muted small">İade son tarihi</div>
                    <div>@fis.IadeSonTarihi.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                </div>
                <div class="col-sm-4">
                    <div class="text-muted small">Hesaplama</div>
                    <div>Satış anındaki net satır tutarı</div>
                </div>
            </div>

            <form method="post" asp-action="Olustur">
                @Html.AntiForgeryToken()
                <input type="hidden" name="FisNo" value="@fis.FisNo" />

                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Ürün</th>
                                <th class="text-end">Satış fiyatı</th>
                                <th class="text-end">Satılan</th>
                                <th class="text-end">Önceki iade</th>
                                <th class="text-end">Kalan</th>
                                <th style="width: 170px">İade miktarı</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < fis.Satirlar.Count; i++)
                            {
                                var satir = fis.Satirlar[i];
                                var girilen = Model.Form.Satirlar.FirstOrDefault(s => s.FisSatirId == satir.FisSatirId)?.Miktar ?? 0;
                                <tr class="@(satir.KalanMiktar <= 0 ? "table-light text-muted" : "")">
                                    <td>
                                        <div>@satir.Ad</div>
                                        <code class="small">@satir.Kod</code>
                                        @if (satir.IndirimTutari > 0)
                                        {
                                            <span class="badge bg-light text-dark">Satır indirimi -@Para(satir.IndirimTutari)</span>
                                        }
                                    </td>
                                    <td class="text-end">@Para(satir.BirimFiyat) ₺</td>
                                    <td class="text-end">@satir.Miktar.ToString("0.###", tr) @satir.Birim</td>
                                    <td class="text-end">@satir.IadeEdilenMiktar.ToString("0.###", tr) @satir.Birim</td>
                                    <td class="text-end fw-semibold">@satir.KalanMiktar.ToString("0.###", tr) @satir.Birim</td>
                                    <td>
                                        <input type="hidden" name="Satirlar[@i].FisSatirId" value="@satir.FisSatirId" />
                                        <input class="form-control" type="number" name="Satirlar[@i].Miktar"
                                               value="@girilen.ToString("0.###", CultureInfo.InvariantCulture)"
                                               min="0" max="@satir.KalanMiktar.ToString("0.####", CultureInfo.InvariantCulture)"
                                               step="@(satir.Birim == "KG" ? "0.001" : "1")"
                                               disabled="@(satir.KalanMiktar <= 0 || !fis.IadeEdilebilir)" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="row g-3 align-items-end">
                    <div class="col-md-8">
                        <label class="form-label" for="aciklama">Açıklama</label>
                        <input class="form-control" id="aciklama" name="Aciklama" maxlength="300"
                               value="@Model.Form.Aciklama" placeholder="İade nedeni (isteğe bağlı)" />
                    </div>
                    <div class="col-md-4 text-md-end">
                        <button type="submit" class="btn btn-danger" disabled="@(!fis.IadeEdilebilir)">
                            <i class="bi bi-arrow-counterclockwise"></i> İadeyi Tamamla
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

