@model MarketOtomasyon.Models.ViewModels.IadeAramaVm
@using System.Globalization
@{
    ViewData["Title"] = "İade";
    var tr = new CultureInfo("tr-TR");
    string Para(decimal deger) => deger.ToString("N2", tr);
}

<div class="ekran">
    @* Fis arama arac cubugunda: iade ekrani her zaman bir fis numarasiyla
       baslar, once onu bulduran alan gelir. *@
    <form method="get" asp-action="Index" class="arac-cubugu">
        <span class="arac-etiket">Fiş no</span>
        <input class="form-control font-monospace" style="width:14rem" id="fisNo" name="fisNo"
               value="@Model.FisNo" autocomplete="off" autofocus
               placeholder="20260821-00001" aria-label="Fiş numarası" />
        <button type="submit" class="btn btn-primary">
            <i class="ph ph-magnifying-glass"></i> Satışı Bul
        </button>

        @if (Model.Fis is not null)
        {
            <span class="arac-ayrac"></span>
            <span class="arac-etiket">Satış</span>
            <strong>@Model.Fis.Tarih.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong>
            <span class="arac-ayrac"></span>
            <span class="arac-etiket">Toplam</span>
            <strong class="fs-5">@Para(Model.Fis.GenelToplam) ₺</strong>
            <span class="arac-ayrac"></span>
            <span class="arac-etiket">İade son tarihi</span>
            <strong>@Model.Fis.IadeSonTarihi.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong>
        }
    </form>

    @if (TempData["Mesaj"] is string mesaj)
    {
        <div class="bildirim bildirim-olumlu"><i class="ph ph-check-circle"></i> @mesaj</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Hata))
    {
        <div class="bildirim bildirim-olumsuz"><i class="ph ph-warning"></i> @Model.Hata</div>
    }

    @if (Model.Fis is null)
    {
        <p class="veri-yok">
            İade almak için önce satış fişinin numarasını girin.
        </p>
    }
    else
    {
        var fis = Model.Fis;

        @if (!fis.IadeEdilebilir)
        {
            <div class="bildirim bildirim-olumsuz">
                <i class="ph ph-clock-counter-clockwise"></i>
                Bu fiş için iade süresi dolmuş. Satır girişleri kapalı.
            </div>
        }

        <form method="post" asp-action="Olustur" style="flex:1; display:flex; flex-direction:column; min-height:0">
            <input type="hidden" name="FisNo" value="@fis.FisNo" />

            <div class="izgara-sarmal">
                <table class="izgara">
                    <thead>
                        <tr>
                            <th>Ürün</th>
                            <th class="sayi" style="width:8rem">Satış fiyatı</th>
                            <th class="sayi" style="width:8rem">Satılan</th>
                            <th class="sayi" style="width:8rem">Önceki iade</th>
                            <th class="sayi" style="width:8rem">Kalan</th>
                            <th class="sayi" style="width:10rem">İade miktarı</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < fis.Satirlar.Count; i++)
                        {
                            var satir = fis.Satirlar[i];
                            var girilen = Model.Form.Satirlar
                                .FirstOrDefault(s => s.FisSatirId == satir.FisSatirId)?.Miktar ?? 0;
                            var tukendi = satir.KalanMiktar <= 0;

                            <tr class="@(tukendi ? "pasif" : "")">
                                <td style="white-space:normal">
                                    <span class="kod">@satir.Kod</span> @satir.Ad
                                    @if (satir.IndirimTutari > 0)
                                    {
                                        <span class="rozet rozet-notr">satır indirimi −@Para(satir.IndirimTutari)</span>
                                    }
                                </td>
                                <td class="sayi">@Para(satir.BirimFiyat)</td>
                                <td class="sayi">@satir.Miktar.ToString("0.###", tr) @satir.Birim</td>
                                <td class="sayi">@satir.IadeEdilenMiktar.ToString("0.###", tr) @satir.Birim</td>
                                <td class="sayi fw-semibold">@satir.KalanMiktar.ToString("0.###", tr) @satir.Birim</td>
                                <td class="sayi">
                                    <input type="hidden" name="Satirlar[@i].FisSatirId" value="@satir.FisSatirId" />
                                    <input class="form-control form-control-sm text-end" type="number"
                                           name="Satirlar[@i].Miktar"
                                           value="@girilen.ToString("0.###", CultureInfo.InvariantCulture)"
                                           min="0"
                                           max="@satir.KalanMiktar.ToString("0.####", CultureInfo.InvariantCulture)"
                                           step="@(satir.Birim == "KG" ? "0.001" : "1")"
                                           disabled="@(tukendi || !fis.IadeEdilebilir)"
                                           aria-label="@satir.Ad iade miktarı" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="arac-cubugu" style="border-top:1px solid var(--izgara-cizgi); border-bottom:none">
                <span class="arac-etiket">Açıklama</span>
                <input class="form-control" style="width:26rem" id="aciklama" name="Aciklama" maxlength="300"
                       value="@Model.Form.Aciklama" placeholder="İade nedeni (isteğe bağlı)"
                       aria-label="İade açıklaması" />

                <div class="arac-sag">
                    <button type="submit" class="btn btn-danger" disabled="@(!fis.IadeEdilebilir)">
                        <i class="ph ph-arrow-counter-clockwise"></i> İadeyi Tamamla
                    </button>
                </div>
            </div>
        </form>
    }

    <div class="durum-cubugu">
        @if (Model.Fis is not null)
        {
            <span>Fiş <strong class="font-monospace">@Model.Fis.FisNo</strong></span>
            <span><strong>@Model.Fis.Satirlar.Count</strong> satır</span>
        }
        <span class="arac-sag">
            İade tutarı satış anındaki net satır tutarından hesaplanır; para iadesi nakit yapılır.
        </span>
    </div>
</div>
