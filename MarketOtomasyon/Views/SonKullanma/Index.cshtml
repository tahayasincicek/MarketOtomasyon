@model MarketOtomasyon.Models.ViewModels.SonKullanmaEkranVm
@{
    ViewData["Title"] = "Son Kullanma Takibi";
}

@*
    Iki ayri tablo, tek listede birlestirilmedi: suresi gecmis mal
    "bugun raftan cek" isi, yaklasan mal "planla" isi. Ayni tabloda
    satir rengiyle ayirmak, uzun listede aciliyeti gorunmez kilardi.
*@
<div class="ekran">
    @if (TempData["Mesaj"] is string mesaj)
    {
        <div class="bildirim bildirim-olumlu"><i class="ph ph-check-circle"></i> @mesaj</div>
    }

    @if (TempData["Hata"] is string hata)
    {
        <div class="bildirim bildirim-olumsuz"><i class="ph ph-warning"></i> @hata</div>
    }

    <div class="arac-cubugu">
        <form method="get" asp-action="Index" class="form-seffaf">
            <div class="arac-alan">
                <label class="form-label small mb-0 me-1" for="depoId">Depo</label>
                <select name="depoId" id="depoId" class="form-select" style="width:12rem">
                    <option value="">Tüm depolar</option>
                    @foreach (var depo in Model.Depolar)
                    {
                        <option value="@depo.Id" selected="@(Model.DepoId == depo.Id)">@depo.Ad</option>
                    }
                </select>
            </div>

            <div class="arac-alan">
                <label class="form-label small mb-0 me-1" for="gunSayisi">İleri</label>
                <input type="number" name="gunSayisi" id="gunSayisi" min="0" max="365"
                       value="@Model.GunSayisi" class="form-control" style="width:6rem" />
                <span class="text-muted small">gün</span>
            </div>

            <button type="submit" class="btn btn-primary">Uygula</button>
        </form>
    </div>

    <div class="d-flex gap-3 flex-wrap mb-3">
        <div class="card flex-fill" style="min-width:14rem">
            <div class="card-body py-2">
                <div class="text-muted small">Süresi geçmiş</div>
                <div class="fs-5 text-danger">@Model.SuresiGecmisler.Count() parti</div>
                <div class="text-muted small">@Model.SuresiGecmisTutar.ToString("N2") ₺ maliyet</div>
            </div>
        </div>
        <div class="card flex-fill" style="min-width:14rem">
            <div class="card-body py-2">
                <div class="text-muted small">Yaklaşan (@Model.GunSayisi gün)</div>
                <div class="fs-5 text-warning">@Model.Yaklasanlar.Count() parti</div>
                <div class="text-muted small">@Model.YaklasanTutar.ToString("N2") ₺ maliyet</div>
            </div>
        </div>
    </div>

    @if (Model.SuresiGecmisler.Any())
    {
        <h2 class="h6 mt-4">
            <span class="rozet rozet-olumsuz">Süresi geçmiş</span>
            <span class="text-muted small ms-2">Bu partiler satılamaz; raftan çekilip zayi'ye alınmalı.</span>
        </h2>

        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Ürün</th>
                    <th>Depo</th>
                    <th>Lot</th>
                    <th>SKT</th>
                    <th class="text-end">Kalan</th>
                    <th class="text-end">Maliyet</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var satir in Model.SuresiGecmisler)
                {
                    <tr>
                        <td>
                            <div>@satir.Ad</div>
                            <div class="text-muted small">@satir.Kod</div>
                        </td>
                        <td>@satir.DepoAd</td>
                        <td class="text-muted small">@(satir.LotNo ?? "—")</td>
                        <td>
                            @satir.SonKullanmaTarihi.ToString("dd.MM.yyyy")
                            <span class="rozet rozet-olumsuz ms-1">@(-satir.KalanGun) gün geçti</span>
                        </td>
                        <td class="text-end">@satir.KalanMiktar.ToString("0.###") @satir.Birim</td>
                        <td class="text-end">@satir.RiskTutari.ToString("N2") ₺</td>
                        <td class="text-end">
                            @* Her satir kendi formu: tek tikla o partinin kalani duser. *@
                            <form method="post" asp-action="ZayiyeAl" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="stokPartiId" value="@satir.StokPartiId" />
                                <input type="hidden" name="gunSayisi" value="@Model.GunSayisi" />
                                <input type="hidden" name="depoId" value="@Model.DepoId" />
                                <input type="hidden" name="sebep" value="Son kullanma tarihi geçti" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('@satir.Ad — @satir.KalanMiktar.ToString("0.###") @satir.Birim zayi\'ye alınacak. Onaylıyor musunuz?');">
                                    <i class="ph ph-trash"></i> Zayi'ye al
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Model.Yaklasanlar.Any())
    {
        <h2 class="h6 mt-4">
            <span class="rozet rozet-uyari">Yaklaşan</span>
            <span class="text-muted small ms-2">Hâlâ satılabilir; öne alın veya indirime çıkarın.</span>
        </h2>

        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Ürün</th>
                    <th>Depo</th>
                    <th>Lot</th>
                    <th>SKT</th>
                    <th class="text-end">Kalan</th>
                    <th class="text-end">Maliyet</th>
                    <th>Tedarikçi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var satir in Model.Yaklasanlar)
                {
                    <tr>
                        <td>
                            <div>@satir.Ad</div>
                            <div class="text-muted small">@satir.Kod</div>
                        </td>
                        <td>@satir.DepoAd</td>
                        <td class="text-muted small">@(satir.LotNo ?? "—")</td>
                        <td>
                            @satir.SonKullanmaTarihi.ToString("dd.MM.yyyy")
                            <span class="rozet rozet-uyari ms-1">@satir.KalanGun gün</span>
                        </td>
                        <td class="text-end">@satir.KalanMiktar.ToString("0.###") @satir.Birim</td>
                        <td class="text-end">@satir.RiskTutari.ToString("N2") ₺</td>
                        <td class="text-muted small">@(satir.TedarikciUnvan ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (!Model.Satirlar.Any())
    {
        <p class="veri-yok">
            <i class="ph ph-check-circle"></i>
            Seçilen aralıkta son kullanma tarihi yaklaşan parti yok.
        </p>
    }
</div>
