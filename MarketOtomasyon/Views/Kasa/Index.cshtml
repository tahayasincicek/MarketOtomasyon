@{
    ViewData["Title"] = "Kasa";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="small text-muted">
        <kbd>Enter</kbd> ekle &nbsp;
        <kbd>F2</kbd> ödeme &nbsp;
        <kbd>F4</kbd> satır sil &nbsp;
        <kbd>F5</kbd> satır indirimi &nbsp;
        <kbd>F6</kbd> fiş indirimi &nbsp;
        <kbd>F7</kbd> askıya al &nbsp;
        <kbd>F8</kbd> bekleyenler &nbsp;
        <kbd>Esc</kbd> iptal
    </div>
</div>

<div class="row g-3">
    <!-- Sol sütun: barkod girişi ve sepet -->
    <div class="col-lg-8">
        <div class="input-group input-group-lg mb-2">
            <span class="input-group-text">Barkod</span>
            <input id="barkod" class="form-control font-monospace" autocomplete="off" autofocus
                   placeholder="Okutun veya yazıp Enter'a basın" />
        </div>

        <div id="uyari" class="alert alert-danger py-2 d-none" role="alert"></div>

        <!-- İndirim paneli. Tarayıcı diyalogu yerine satır içi: odak kaybolmasın. -->
        <div id="indirim-paneli" class="card border-secondary mb-2 d-none">
            <div class="card-body py-2">
                <div class="row g-2 align-items-end">
                    <div class="col-auto">
                        <label class="form-label mb-0 small" id="indirim-baslik">İndirim</label>
                        <div class="input-group input-group-sm">
                            <input id="indirim-yuzde" type="text" class="form-control text-end" style="width:5rem" />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                    <div class="col-auto">
                        <label class="form-label mb-0 small">Onaylayan</label>
                        <select id="indirim-onaylayan" class="form-select form-select-sm">
                            <option value="">(kasiyer)</option>
                            <option value="2">Müdür onayı</option>
                        </select>
                    </div>
                    <div class="col-auto">
                        <button type="button" id="btn-indirim-uygula" class="btn btn-sm btn-primary">Uygula</button>
                        <button type="button" id="btn-indirim-kaldir" class="btn btn-sm btn-outline-secondary">Kaldır</button>
                        <button type="button" id="btn-indirim-vazgec" class="btn btn-sm btn-link">Vazgeç</button>
                    </div>
                </div>
                <div class="form-text">
                    Kasiyer satırda en fazla %10, fişte en fazla %5 indirim verebilir; üstü müdür onayı ister.
                </div>
            </div>
        </div>

        <div class="table-responsive border rounded">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:3rem">#</th>
                        <th>Ürün</th>
                        <th class="text-end" style="width:8rem">Miktar</th>
                        <th class="text-end" style="width:8rem">Birim Fiyat</th>
                        <th class="text-end" style="width:9rem">Tutar</th>
                        <th style="width:3rem"></th>
                    </tr>
                </thead>
                <tbody id="sepet-govde"></tbody>
            </table>
            <p id="bos-sepet" class="text-center text-muted py-5 mb-0">
                Sepet boş — barkod okutarak başlayın.
            </p>
        </div>

        <div class="form-text mt-2">
            Satıra tıklayarak seçin, <kbd>F4</kbd> ile silin. Miktar kutusunu değiştirip
            <kbd>Enter</kbd>'a basarak güncelleyin; 0 yazarsanız satır silinir.
        </div>
    </div>

    <!-- Sağ sütun: özet ve toplam -->
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-body py-2">
                <div class="text-uppercase text-muted" style="font-size:.7rem;letter-spacing:.08em">Son okutulan</div>
                <div id="son-ad" class="fs-5 fw-semibold">—</div>
                <div id="son-detay" class="text-muted small"></div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header py-2 d-flex justify-content-between">
                <span>Fiş</span>
                <span id="fis-no" class="text-muted font-monospace small">—</span>
            </div>
            <div class="card-body py-2">
                <div class="d-flex justify-content-between d-none" id="indirim-satiri">
                    <span class="text-muted">Toplam indirim</span>
                    <span id="toplam-indirim" class="text-danger">0,00</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Ara toplam (KDV hariç)</span>
                    <span id="ara-toplam">0,00</span>
                </div>
                <div id="kdv-kirilimi" class="mt-1"></div>
                <div class="d-flex justify-content-between border-top pt-1 mt-1">
                    <span class="text-muted">Toplam KDV</span>
                    <span id="toplam-kdv">0,00</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Satır</span>
                    <span id="satir-sayisi">0</span>
                </div>
            </div>
        </div>

        <div class="card text-bg-success mb-3">
            <div class="card-body text-end py-3">
                <div class="text-uppercase" style="font-size:.7rem;letter-spacing:.12em;opacity:.85">Toplam</div>
                <div id="genel-toplam" class="fw-bold" style="font-size:2.4rem;line-height:1.1">0,00 ₺</div>
            </div>
        </div>

        <div class="d-grid gap-2">
            <button type="button" id="btn-odeme" class="btn btn-primary btn-lg" disabled>
                <i class="bi bi-cash-coin"></i> Ödeme Al (F2)
            </button>
            <button type="button" id="btn-fis-indirim" class="btn btn-outline-secondary">
                <i class="bi bi-percent"></i> Fişe İndirim (F6)
            </button>
            <div class="d-flex gap-2">
                <button type="button" id="btn-askiya-al" class="btn btn-outline-secondary flex-fill">
                    <i class="bi bi-pause-circle"></i> Askıya Al (F7)
                </button>
                <button type="button" id="btn-bekleyenler" class="btn btn-outline-secondary flex-fill position-relative">
                    <i class="bi bi-list-check"></i> Bekleyenler (F8)
                    <span id="bekleyen-sayisi" class="badge bg-warning text-dark position-absolute top-0 start-100 translate-middle d-none">0</span>
                </button>
            </div>
            <button type="button" id="btn-iptal" class="btn btn-outline-danger">
                <i class="bi bi-x-circle"></i> Fişi İptal Et (Esc)
            </button>
        </div>
    </div>
</div>

<!-- Bekleyen (askıdaki) fişler -->
<div class="modal fade" id="bekleyenler-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title">Bekleyen Fişler</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div class="form-text mb-2">
                    Askıya alınmış sepetler stoğu etkilemez. Geri çağırdığınızda kasadaki dolu sepet
                    otomatik olarak askıya alınır.
                </div>
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Fiş No</th>
                            <th>Saat</th>
                            <th class="text-end">Satır</th>
                            <th class="text-end">Tutar</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="bekleyenler-govde"></tbody>
                </table>
                <p id="bekleyen-yok" class="text-center text-muted py-4 mb-0 d-none">
                    Askıda bekleyen fiş yok.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Ödeme penceresi -->
<div class="modal fade" id="odeme-modal" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title">Ödeme <span id="odeme-fis-no" class="text-muted font-monospace small ms-2"></span></h5>
            </div>

            <div class="modal-body">
                <div id="odeme-uyari" class="alert alert-danger py-2 d-none" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-5">
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Fiş toplamı</span>
                            <span id="odeme-genel-toplam">0,00</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Ödenen</span>
                            <span id="odeme-odenen">0,00</span>
                        </div>
                        <div class="d-flex justify-content-between border-top pt-2 mt-2">
                            <span class="fw-semibold">KALAN</span>
                            <span id="odeme-kalan" class="fs-4 fw-bold text-danger">0,00</span>
                        </div>

                        <div id="para-ustu-kutusu" class="alert alert-warning mt-3 mb-0 py-2 d-none">
                            <div class="small">Para üstü</div>
                            <div id="para-ustu" class="fs-3 fw-bold">0,00</div>
                        </div>

                        <div id="odeme-tamam" class="alert alert-success mt-3 mb-0 py-2 d-none">
                            Ödeme tamamlandı, fiş kapandı ve stok düşüldü.
                        </div>

                        <div id="stok-uyari" class="alert alert-warning mt-3 mb-0 py-2 small d-none"></div>
                    </div>

                    <div class="col-md-7">
                        <div class="alert alert-secondary py-2 small mb-2">
                            Şu an yalnızca <strong>nakit</strong> ödeme alınabiliyor.
                            Kart ödemesi POS entegrasyonu yapıldığında açılacak.
                        </div>

                        <div class="mb-2">
                            <label class="form-label mb-0 small">Mahsup edilecek tutar</label>
                            <input id="odeme-tutar" type="text" class="form-control text-end" autocomplete="off" />
                            <div class="form-text">Kalanın tamamı için boş bırakabilirsiniz.</div>
                        </div>

                        <div class="mb-2">
                            <label class="form-label mb-0 small">Müşteriden alınan</label>
                            <input id="odeme-alinan" type="text" class="form-control text-end" autocomplete="off" />
                        </div>

                        <button type="button" id="btn-odeme-ekle" class="btn btn-primary w-100">Ödemeyi Ekle</button>
                    </div>
                </div>

                <table class="table table-sm mt-3 mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tip</th>
                            <th class="text-end">Tutar</th>
                            <th class="text-end">Alınan</th>
                            <th class="text-end">Para üstü</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="odeme-listesi"></tbody>
                </table>
            </div>

            <div class="modal-footer py-2">
                <button type="button" id="btn-odeme-vazgec" class="btn btn-outline-secondary">
                    Vazgeç ve sepete dön
                </button>
                @* Ayni sekmede acilir: kasa terminalinde her satista yeni sekme
                   birakmak vardiya sonunda onlarca acik sekme demek. Fis
                   sayfasindaki "Kasaya dön" butonu geri getirir. *@
                <a id="btn-fis-yazdir" class="btn btn-outline-secondary d-none" href="#">
                    <i class="bi bi-printer"></i> Fişi Yazdır
                </a>
                <button type="button" id="btn-odeme-kapat" class="btn btn-success d-none">Yeni Fiş</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/kasa.js" asp-append-version="true"></script>
    <script src="~/js/odeme.js" asp-append-version="true"></script>
    <script src="~/js/askiya-alma.js" asp-append-version="true"></script>
}
