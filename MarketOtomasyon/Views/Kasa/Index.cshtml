@{
    ViewData["Title"] = "Kasa";
}

@* Kasa ekrani tek bir calisma yuzeyidir: solda barkod + sepet izgarasi,
   sagda fis ozeti ve tahsilat tuslari. Kutucuk yok -- kasiyerin gozu
   barkod alaninda baslar, sepette iner, sag alttaki toplamda biter. *@
<div class="ekran">
    <div class="arac-cubugu">
        <span class="arac-etiket">Barkod</span>
        <input id="barkod" class="form-control font-monospace" style="width:22rem;font-size:1.1rem"
               autocomplete="off" autofocus
               placeholder="Okutun veya yazıp Enter'a basın" aria-label="Barkod" />

        <span class="arac-ayrac"></span>

        <button type="button" id="btn-fis-indirim" class="btn btn-outline-secondary">
            <i class="bi bi-percent"></i> Fişe İndirim
        </button>
        <button type="button" id="btn-askiya-al" class="btn btn-outline-secondary">
            <i class="bi bi-pause-circle"></i> Askıya Al
        </button>
        <button type="button" id="btn-bekleyenler" class="btn btn-outline-secondary position-relative">
            <i class="bi bi-list-check"></i> Bekleyenler
            <span id="bekleyen-sayisi"
                  class="badge bg-warning text-dark position-absolute top-0 start-100 translate-middle d-none">0</span>
        </button>
        <button type="button" id="btn-iptal" class="btn btn-outline-danger">
            <i class="bi bi-x-circle"></i> Fişi İptal Et
        </button>
        <button type="button" id="btn-kamera" class="btn btn-outline-secondary">
            <i class="bi bi-camera-video"></i> Kamera
        </button>

        <div class="arac-sag d-flex align-items-center gap-2">
            <span class="arac-etiket">Fiş</span>
            <strong id="fis-no" class="font-monospace">—</strong>
        </div>
    </div>

    <div id="uyari" class="bildirim bildirim-olumsuz d-none" role="alert"></div>
    @* Kamera paneli: kapaliyken hic yer kaplamaz, video akisi da baslamaz.
       Kamera acikken barkod alanindan odak kacmaz -- el terminali de
       kullanilabilsin diye ikisi ayni anda calisir. *@
    <div id="kamera-paneli" class="arac-cubugu d-none" style="background:#f8fafc">
        <video id="kamera-video" playsinline muted
               style="width:22rem;max-width:100%;height:12rem;object-fit:cover;background:#111827;border-radius:.25rem"></video>

        <div class="d-flex flex-column gap-1" style="min-width:0">
            <span class="arac-etiket">Kamera</span>
            <select id="kamera-secim" class="form-select" style="width:15rem"
                    aria-label="Kamera seç"></select>

            <div id="kamera-durum" class="ipucu">Kamera kapalı.</div>
            <div id="kamera-son" class="ipucu"></div>
        </div>

        <span class="ipucu arac-sag" style="max-width:18rem">
            Barkodu kameranın ortasına, ekrana paralel tutun. Aynı barkod
            2 saniye içinde tekrar okunmaz.
        </span>
    </div>




    @* Indirim paneli tarayici diyalogu yerine satir ici: modal acilinca
       barkod alanindan odak kacar, kasiyer sirada bekletir. *@
    <div id="indirim-paneli" class="arac-cubugu d-none" style="background:#fffbeb">
        <span class="arac-etiket" id="indirim-baslik">İndirim</span>
        <div class="input-group input-group-sm" style="width:7rem">
            <input id="indirim-yuzde" type="text" class="form-control text-end" aria-label="İndirim yüzdesi" />
            <span class="input-group-text">%</span>
        </div>

        <span class="arac-etiket">Onaylayan</span>
        <select id="indirim-onaylayan" class="form-select" style="width:9rem" aria-label="Onaylayan">
            <option value="">(kasiyer)</option>
            <option value="2">Müdür onayı</option>
        </select>

        <button type="button" id="btn-indirim-uygula" class="btn btn-primary">Uygula</button>
        <button type="button" id="btn-indirim-kaldir" class="btn btn-outline-secondary">Kaldır</button>
        <button type="button" id="btn-indirim-vazgec" class="btn btn-link btn-sm">Vazgeç</button>

        <span class="ipucu arac-sag">
            Kasiyer satırda en fazla %10, fişte %5 indirim verebilir; üstü müdür onayı ister.
        </span>
    </div>

    <div class="panel-serit" style="flex:1; min-height:0; align-items:stretch">

        <!-- Sepet -->
        <div class="panel" style="flex:3 1 34rem">
            <div class="izgara-sarmal">
                <table class="izgara">
                    <thead>
                        <tr>
                            <th style="width:3rem">#</th>
                            <th>Ürün</th>
                            <th class="sayi" style="width:8rem">Miktar</th>
                            <th class="sayi" style="width:8rem">Birim Fiyat</th>
                            <th class="sayi" style="width:9rem">Tutar</th>
                            <th class="islem"></th>
                        </tr>
                    </thead>
                    <tbody id="sepet-govde"></tbody>
                </table>

                <p id="bos-sepet" class="veri-yok">Sepet boş — barkod okutarak başlayın.</p>
            </div>
        </div>

        <!-- Fis ozeti ve tahsilat -->
        <div class="panel" style="flex:1 1 20rem">
            <div class="panel-baslik">
                <span>Son okutulan</span>
            </div>
            @* Fotograf kasiyerin yanlis urun okuttugunu aninda gormesini saglar;
               asil faydasi bu. Resim yoksa yer tutucu ayni yeri kaplar ki
               panel her okutmada zipzip yer degistirmesin. *@
            <div class="panel-govde son-okutulan" style="flex:none">
                <span id="son-resim" class="urun-resim urun-resim-yok urun-resim-buyuk"
                      role="img" aria-label="Son okutulan ürün">
                    <i class="bi bi-upc-scan"></i>
                </span>
                <div id="son-ad" class="fs-5 fw-semibold">—</div>
                <div id="son-detay" class="ipucu"></div>
            </div>

            <div class="panel-baslik"><span>Fiş özeti</span></div>
            <div class="panel-govde" style="flex:none">
                <div class="cekmece-satir d-none" id="indirim-satiri" style="color:#b91c1c">
                    <span>Toplam indirim</span><span id="toplam-indirim">0,00</span>
                </div>
                <div class="cekmece-satir" style="color:#4b5563">
                    <span>Ara toplam (KDV hariç)</span><span id="ara-toplam">0,00</span>
                </div>
                <div id="kdv-kirilimi"></div>
                <div class="cekmece-satir" style="color:#4b5563;border-top:1px solid var(--izgara-cizgi)">
                    <span>Toplam KDV</span><span id="toplam-kdv">0,00</span>
                </div>
                <div class="cekmece-satir" style="color:#4b5563">
                    <span>Satır</span><span id="satir-sayisi">0</span>
                </div>
            </div>

            @* Toplam, ekranin en kuvvetli ogesi. Musteri de bu rakami gorur. *@
            <div class="cekmece" style="flex:none;background:#166534">
                <div class="cekmece-toplam-etiket">Toplam</div>
                <div id="genel-toplam" class="cekmece-toplam-tutar">0,00 ₺</div>
            </div>

            <div class="panel-govde" style="flex:none">
                <div class="d-grid">
                    <button type="button" id="btn-odeme" class="btn btn-primary btn-lg" disabled>
                        <i class="bi bi-cash-coin"></i> Ödeme Al (F2)
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* F-tusu lejandi altta sabit: masaustu otomasyonlarin standardi,
       kasiyer kisayolu ezberlemek zorunda kalmaz. *@
    <div class="durum-cubugu">
        <div class="fkey-serit">
            <span class="fkey"><b>Enter</b> ekle</span>
            <span class="fkey"><b>F2</b> ödeme</span>
            <span class="fkey"><b>F4</b> satır sil</span>
            <span class="fkey"><b>F5</b> satır indirimi</span>
            <span class="fkey"><b>F6</b> fiş indirimi</span>
            <span class="fkey"><b>F7</b> askıya al</span>
            <span class="fkey"><b>F8</b> bekleyenler</span>
            <span class="fkey"><b>Esc</b> iptal</span>
        </div>
        <span class="arac-sag ipucu">
            Satıra tıklayıp <b>F4</b> ile silin; miktar kutusuna 0 yazıp Enter da siler.
        </span>
    </div>
</div>

<!-- Bekleyen (askıdaki) fişler -->
<div class="modal fade" id="bekleyenler-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title">Bekleyen Fişler</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-0">
                <div class="bildirim bildirim-bilgi">
                    <i class="bi bi-info-circle"></i>
                    Askıya alınmış sepetler stoğu etkilemez. Geri çağırdığınızda kasadaki dolu sepet
                    otomatik olarak askıya alınır.
                </div>
                <table class="izgara">
                    <thead>
                        <tr>
                            <th>Fiş No</th>
                            <th style="width:6rem">Saat</th>
                            <th class="sayi" style="width:5rem">Satır</th>
                            <th class="sayi" style="width:8rem">Tutar</th>
                            <th class="islem"></th>
                        </tr>
                    </thead>
                    <tbody id="bekleyenler-govde"></tbody>
                </table>
                <p id="bekleyen-yok" class="veri-yok d-none">Askıda bekleyen fiş yok.</p>
            </div>
        </div>
    </div>
</div>

<!-- Ödeme penceresi -->
<div class="modal fade" id="odeme-modal" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title">
                    Ödeme <span id="odeme-fis-no" class="text-muted font-monospace small ms-2"></span>
                </h5>
            </div>

            <div class="modal-body p-0">
                <div id="odeme-uyari" class="bildirim bildirim-olumsuz d-none" role="alert"></div>

                <div class="panel-serit">
                    <div class="panel" style="flex:1 1 15rem">
                        <div class="panel-govde">
                            <div class="cekmece-satir" style="color:#4b5563">
                                <span>Fiş toplamı</span><span id="odeme-genel-toplam">0,00</span>
                            </div>
                            <div class="cekmece-satir" style="color:#4b5563">
                                <span>Ödenen</span><span id="odeme-odenen">0,00</span>
                            </div>
                            <div class="fark-kutu acik mt-2">
                                <div class="arac-etiket">Kalan</div>
                                <div id="odeme-kalan" class="fark-tutar">0,00</div>
                            </div>

                            <div id="para-ustu-kutusu" class="fark-kutu fazla mt-2 d-none">
                                <div class="arac-etiket">Para üstü</div>
                                <div id="para-ustu" class="fark-tutar">0,00</div>
                            </div>

                            <div id="odeme-tamam" class="bildirim bildirim-olumlu mt-2 d-none">
                                <i class="bi bi-check-circle"></i>
                                Ödeme tamamlandı, fiş kapandı ve stok düşüldü.
                            </div>

                            <div id="stok-uyari" class="bildirim bildirim-olumsuz mt-2 d-none"></div>
                        </div>
                    </div>

                    <div class="panel" style="flex:1 1 18rem">
                        <div class="panel-govde">
                            <div class="ipucu mb-2">
                                Şu an yalnızca <strong>nakit</strong> ödeme alınabiliyor.
                                Kart ödemesi POS entegrasyonu yapıldığında açılacak.
                            </div>

                            <div class="alan">
                                <label for="odeme-tutar">Mahsup</label>
                                <div class="deger">
                                    <input id="odeme-tutar" type="text" class="form-control text-end"
                                           autocomplete="off" />
                                </div>
                            </div>
                            <div class="alan">
                                <label></label>
                                <div class="deger ipucu">Kalanın tamamı için boş bırakabilirsiniz.</div>
                            </div>
                            <div class="alan">
                                <label for="odeme-alinan">Alınan</label>
                                <div class="deger">
                                    <input id="odeme-alinan" type="text" class="form-control text-end"
                                           autocomplete="off" />
                                </div>
                            </div>

                            <div class="d-grid mt-2">
                                <button type="button" id="btn-odeme-ekle" class="btn btn-primary">
                                    Ödemeyi Ekle
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <table class="izgara">
                    <thead>
                        <tr>
                            <th>Tip</th>
                            <th class="sayi" style="width:8rem">Tutar</th>
                            <th class="sayi" style="width:8rem">Alınan</th>
                            <th class="sayi" style="width:8rem">Para üstü</th>
                            <th class="islem"></th>
                        </tr>
                    </thead>
                    <tbody id="odeme-listesi"></tbody>
                </table>
            </div>

            <div class="modal-footer py-2">
                <button type="button" id="btn-odeme-vazgec" class="btn btn-outline-secondary">
                    Vazgeç ve sepete dön
                </button>
                <button type="button" id="btn-fis-yazdir" class="btn btn-outline-secondary d-none">
                    <i class="bi bi-printer"></i> Fişi Yazdır
                </button>
                <button type="button" id="btn-odeme-kapat" class="btn btn-success d-none">Yeni Fiş</button>
            </div>
        </div>
    </div>
</div>

<!-- Fiş önizleme: kasa ekranından ayrılmadan yalnızca fişi gösterir. -->
<div class="modal fade" id="fis-onizleme-modal" tabindex="-1"
     aria-labelledby="fis-onizleme-baslik" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered fis-onizleme-dialog">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="fis-onizleme-baslik">
                    <i class="bi bi-receipt me-1"></i> Fiş Önizleme
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>

            <div class="modal-body fis-onizleme-govde">
                <div id="fis-onizleme-yukleniyor" class="fis-onizleme-durum" role="status">
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    Fiş hazırlanıyor…
                </div>
                <div id="fis-onizleme-hata" class="bildirim bildirim-olumsuz d-none" role="alert"></div>
                <div id="fis-onizleme-icerik" class="fis-onizleme-icerik d-none"></div>
            </div>

            <div class="modal-footer py-2">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Kasaya Dön
                </button>
                <button type="button" id="btn-fis-onizleme-yazdir" class="btn btn-primary" disabled>
                    <i class="bi bi-printer"></i> Yazdır
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/zxing/index.min.js" asp-append-version="true"></script>
    <script src="~/js/kasa.js" asp-append-version="true"></script>
    <script src="~/js/odeme.js" asp-append-version="true"></script>
    <script src="~/js/askiya-alma.js" asp-append-version="true"></script>
    <script src="~/js/kamera.js" asp-append-version="true"></script>
}
